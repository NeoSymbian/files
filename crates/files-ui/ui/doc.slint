// SPDX-License-Identifier: GPL-3.0-only
// FA10 (documents): what the Rust layout (neo-format-document) places, drawn at its pixels: text runs in the document
// faces (NeoDoc = DejaVu Sans, its Bold and Oblique, and DejaVu Sans Mono: Latin, Greek, Cyrillic and Armenian), images and rectangles (rules,
// table lines, underlines, page sheets). Rust hands over only what shows (a page, or a window of a long document).

import { Theme, Glyph } from "@neoui/kit.slint";

// a run of text: x, y its top-left in px, `face` 0 regular, 1 bold, 2 italic, 3 mono
export struct DText { x: int, y: int, px: int, face: int, text: string, colour: color }
export struct DImage { x: int, y: int, w: int, h: int, image: image }
export struct DRect { x: int, y: int, w: int, h: int, colour: color }

export component DocItems inherits Rectangle {
    in property <[DText]> texts;
    in property <[DImage]> images;
    in property <[DRect]> rects;
    // where the items' (0, 0) is
    in property <length> dx;
    in property <length> dy;
    for r in root.rects: Rectangle {
        x: root.dx + r.x * 1px;
        y: root.dy + r.y * 1px;
        width: r.w * 1px;
        height: r.h * 1px;
        background: r.colour;
    }
    for i in root.images: Image {
        x: root.dx + i.x * 1px;
        y: root.dy + i.y * 1px;
        width: i.w * 1px;
        height: i.h * 1px;
        source: i.image;
        image-fit: fill;
    }
    for t in root.texts: Text {
        x: root.dx + t.x * 1px;
        y: root.dy + t.y * 1px;
        text: t.text;
        font-size: t.px * 1px;
        font-family: t.face == 3 ? "DejaVu Sans Mono" : "NeoDoc";
        font-weight: t.face == 1 ? 700 : 400;
        font-italic: t.face == 2;
        color: t.colour;
    }
}

// the yardstick the Rust layout calibrates its advances with (one hidden run)
export component DocProbe inherits Text {
    visible: false;
    in property <int> px;
    in property <int> face;
    font-size: root.px * 1px;
    font-family: root.face == 3 ? "DejaVu Sans Mono" : "NeoDoc";
    font-weight: root.face == 1 ? 700 : 400;
    font-italic: root.face == 2;
}


// Page | Reflow (files2-view-docx's pill)
component Pill inherits Rectangle {
    in property <[string]> items;
    in property <int> current;
    in property <bool> first-enabled: true;
    callback picked(int);
    height: 32 * Theme.dp;
    width: lay.preferred-width;
    border-radius: 16 * Theme.dp;
    background: #1d2025;
    lay := HorizontalLayout {
        padding: 2 * Theme.dp;
        spacing: 2 * Theme.dp;
        for s[i] in root.items: Rectangle {
            border-radius: 14 * Theme.dp;
            width: t.preferred-width + 24 * Theme.dp;
            background: i == root.current ? #3d8bfd33 : transparent;
            t := Text {
                text: s;
                color: i == root.current ? #cfe0ff : #b9bec7;
                font-size: 13 * Theme.dp;
                font-weight: 600;
            }

            TouchArea {
                clicked => {
                    root.picked(i);
                }
            }
        }
    }
}

// files2-view-docx: the Page | Reflow bar, the document (pages on grey, or one long sheet of paper), and the
// footer with its kind, size and how far down it is. Rust lays out what shows (a window around the scroll position).
export component DocView inherits Rectangle {
    in property <int> mode;
    in property <[DText]> texts;
    in property <[DImage]> images;
    in property <[DRect]> rects;
    // the whole document's height, and where the items' (0, 0) is, px
    in property <int> total;
    // the content's width, px: a zoomed page is wider than the view
    in property <int> total-w;
    in property <int> window-top;
    in property <color> paper;
    in property <string> info;
    in property <string> percent;
    out property <int> view-w: flick.width / 1px;
    out property <int> view-h: flick.height / 1px;
    callback mode-picked(int);
    callback scrolled(int);
    callback scrolled-x(int);
    callback tapped(length, length);
    background: #000000;
    public function to-top() {
        flick.content-y = 0;
    }
    public function scroll-to(px: int) {
        flick.content-y = -min(max(0, px), max(0, root.total - root.view-h)) * 1px;
    }
    public function scroll-x-to(px: int) {
        flick.content-x = -min(max(0, px), max(0, root.total-w - root.view-w)) * 1px;
    }

    VerticalLayout {
        Rectangle {
            height: 44 * Theme.dp;
            HorizontalLayout {
                padding-left: 12 * Theme.dp;
                padding-right: 12 * Theme.dp;
                spacing: 10 * Theme.dp;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    Pill {
                        items: ["Page", "Reflow"];
                        current: root.mode;
                        picked(i) => {
                            root.mode-picked(i);
                        }
                    }
                }

                Text {
                    text: "Read-only";
                    color: #7d838c;
                    font-size: 12.5 * Theme.dp;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                y: parent.height - self.height;
                height: max(1px, Theme.dp / 3);
                background: #ffffff12;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            background: root.mode == 0 ? #2b2e33 : root.paper;
            clip: true;
            flick := Flickable {
                content-height: max(self.height, root.total * 1px);
                content-width: max(self.width, root.total-w * 1px);
                changed content-y => {
                    root.scrolled(-self.content-y / 1px);
                }
                changed content-x => {
                    root.scrolled-x(-self.content-x / 1px);
                }
                DocItems {
                    y: root.window-top * 1px;
                    width: max(parent.width, root.total-w * 1px);
                    height: 1px;
                    texts: root.texts;
                    images: root.images;
                    rects: root.rects;
                }

                TouchArea {
                    clicked => {
                        root.tapped(self.mouse-x, self.mouse-y);
                    }
                }
            }
        }

        Rectangle {
            height: 30 * Theme.dp;
            Rectangle {
                y: 0;
                height: max(1px, Theme.dp / 3);
                background: #ffffff12;
            }

            HorizontalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 16 * Theme.dp;
                Text {
                    horizontal-stretch: 1;
                    text: root.info;
                    color: #7d838c;
                    font-size: 12.5 * Theme.dp;
                    vertical-alignment: center;
                }

                Text {
                    text: root.percent;
                    color: #7d838c;
                    font-size: 12.5 * Theme.dp;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// a control on the reader's bar
component ReaderButton inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    callback clicked();
    height: 40 * Theme.dp;
    width: max(56 * Theme.dp, t.preferred-width + 24 * Theme.dp);
    border-radius: 20 * Theme.dp;
    background: ta.pressed ? #ffffff22 : #ffffff10;
    t := Text {
        text: root.text;
        color: root.ink;
        font-size: 14 * Theme.dp;
        font-weight: 600;
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// files2-view-epub: the book's title over the page, the page (Rust lays it out: a chapter cut into pages), the
// progress bar with the chapter and the page; taps on the left and right quarters turn pages (swipes too), a tap in
// the middle shows the controls (Contents, A−, A+, the theme); Contents lists the chapters.
export component BookView inherits Rectangle {
    in property <[DText]> texts;
    in property <[DImage]> images;
    in property <[DRect]> rects;
    in property <string> title;
    in property <string> where;
    in property <string> page;
    in property <float> progress;
    in property <color> paper: #f4ecd8;
    in property <color> muted: #8a7a62;
    in property <color> track: #ddd0b3;
    in property <color> fill: #a0703c;
    in property <string> theme-name: "Sepia";
    in property <bool> controls;
    in property <bool> contents-open;
    in property <[string]> contents;
    in property <[int]> contents-depth;
    in property <int> contents-current;
    out property <int> page-w: body.width / 1px;
    out property <int> page-h: body.height / 1px;
    callback turn(int);
    callback toggle-controls();
    callback control(int);
    callback contents-chosen(int);
    callback contents-closed();
    background: root.paper;
    VerticalLayout {
        Rectangle {
            height: 40 * Theme.dp;
            Text {
                x: 24 * Theme.dp;
                width: parent.width - 48 * Theme.dp;
                text: root.title;
                color: root.muted;
                font-family: "NeoDoc";
                font-size: 12 * Theme.dp;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        Rectangle {
            vertical-stretch: 1;
            body := Rectangle {
                x: 24 * Theme.dp;
                y: 4 * Theme.dp;
                width: parent.width - 48 * Theme.dp;
                height: parent.height - 4 * Theme.dp;
                clip: true;
                DocItems {
                    width: parent.width;
                    height: parent.height;
                    texts: root.texts;
                    images: root.images;
                    rects: root.rects;
                }
            }

            TouchArea {
                pointer-event(e) => {
                    if e.kind == PointerEventKind.up {
                        if abs(self.mouse-x - self.pressed-x) > 40 * Theme.dp {
                            root.turn(self.mouse-x < self.pressed-x ? 1 : -1);
                        } else if self.mouse-x < self.width * 0.26 {
                            root.turn(-1);
                        } else if self.mouse-x > self.width * 0.74 {
                            root.turn(1);
                        } else {
                            root.toggle-controls();
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 58 * Theme.dp;
            VerticalLayout {
                padding-left: 24 * Theme.dp;
                padding-right: 24 * Theme.dp;
                alignment: center;
                spacing: 7 * Theme.dp;
                Rectangle {
                    height: 3 * Theme.dp;
                    border-radius: 2 * Theme.dp;
                    background: root.track;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.progress, 0, 1);
                        border-radius: 2 * Theme.dp;
                        background: root.fill;
                    }
                }

                HorizontalLayout {
                    Text {
                        horizontal-stretch: 1;
                        text: root.where;
                        color: root.muted;
                        font-family: "NeoDoc";
                        font-size: 12 * Theme.dp;
                        overflow: elide;
                    }

                    Text {
                        text: root.page;
                        color: root.muted;
                        font-size: 12 * Theme.dp;
                    }
                }
            }
        }
    }

    if root.controls: Rectangle {
        y: parent.height - 58 * Theme.dp - self.height;
        height: 60 * Theme.dp;
        background: #1d2025;
        HorizontalLayout {
            padding-left: 12 * Theme.dp;
            padding-right: 12 * Theme.dp;
            spacing: 8 * Theme.dp;
            alignment: space-between;
            VerticalLayout {
                alignment: center;
                ReaderButton {
                    text: "Contents";
                    ink: #ffffff;
                    clicked => {
                        root.control(0);
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                ReaderButton {
                    text: "A−";
                    ink: #ffffff;
                    clicked => {
                        root.control(1);
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                ReaderButton {
                    text: "A+";
                    ink: #ffffff;
                    clicked => {
                        root.control(2);
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                ReaderButton {
                    text: root.theme-name;
                    ink: #ffffff;
                    clicked => {
                        root.control(3);
                    }
                }
            }
        }
    }

    if root.contents-open: Rectangle {
        background: #0b0c0e;
        TouchArea { }
        VerticalLayout {
            Rectangle {
                height: 48 * Theme.dp;
                HorizontalLayout {
                    padding-left: 20 * Theme.dp;
                    padding-right: 4 * Theme.dp;
                    Text {
                        horizontal-stretch: 1;
                        text: "Contents";
                        color: #ffffff;
                        font-size: 19 * Theme.dp;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 48 * Theme.dp;
                        Glyph {
                            source: @image-url("@neoui/icons/sys/close.svg");
                            size: 24 * Theme.dp;
                            colorize: #b9bec7;
                        }

                        TouchArea {
                            clicked => {
                                root.contents-closed();
                            }
                        }
                    }
                }
            }

            Flickable {
                vertical-stretch: 1;
                VerticalLayout {
                    for c[i] in root.contents: Rectangle {
                        height: 52 * Theme.dp;
                        background: ta.pressed ? #ffffff10 : transparent;
                        Text {
                            x: (20 + 16 * root.contents-depth[i]) * Theme.dp;
                            width: parent.width - self.x - 20 * Theme.dp;
                            text: c;
                            color: i == root.contents-current ? #cfe0ff : #e6e8eb;
                            font-family: "NeoDoc";
                            font-weight: i == root.contents-current ? 700 : 400;
                            font-size: 16 * Theme.dp;
                            overflow: elide;
                            vertical-alignment: center;
                        }

                        ta := TouchArea {
                            clicked => {
                                root.contents-chosen(i);
                            }
                        }
                    }
                }
            }
        }
    }
}
