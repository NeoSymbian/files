// SPDX-License-Identifier: GPL-3.0-only
// The Files app (NEOFILES.EXE), v2 (docs files-app.md FA1 + FA2, the canvas's files2-* boards) on the neoui kit:
// the Browse tab (drives), folders as a list or a grid with a breadcrumb, the folder and selection menus, the Sort
// sheet, the read-only banner, New folder / New file / Rename forms, the paste bar, a copy's progress toast and the
// name-clash dialog; FA3: Favourites and the Recent strip, the Recent and Types tabs, search with filters, the Recycle
// bin, Free up space and Details; FA4: the text viewer and the editors (code with colours, find and replace, Markdown
// Preview, the CSV table), New file's types. The shell draws QUERY dialogs, toasts with Undo and the shade entry.
// The Rust side owns the state; this file draws it and reports taps as callbacks.
import "@neoui/fonts/NeoSans-Regular.ttf";
import "@neoui/fonts/NeoSans-Medium.ttf";
import "@neoui/fonts/NeoSans-SemiBold.ttf";
import "@neoui/fonts/NeoSans-Bold.ttf";
// Latin, Cyrillic and Armenian: names and text typed on the system keyboard, in any of its languages
import "@neoui/fonts/DejaVuSans.ttf";
import "@neoui/fonts/DejaVuSansMono.ttf";
import {
    Theme, Kit, KeyboardFocus, Scroll, Alphabets, Glyph, NeoList, Header, SubHeader, FormHeader, TextField, Act, Tab, Footer,
    Sheet, Switch, Button, ProgressBar
} from "@neoui/kit.slint";
import { FTile, FolderTile, DriveTile, Thumb } from "tiles.slint";
import { StripItem, ImageView, ImageEdit } from "image.slint";
import { TypeTile, Seg, CleanCard, Detail, Pick, UsedCard, GroupTile, CleanItem, InfoCard, DetailRow } from "fa3.slint";
import { TSpan, TRow, Mark, TextPane, TextMetrics } from "text.slint";
import { PackItem, WayRow, JobCard, ArchiveBar, ViewOnly, CompressForm, FolderPicker } from "fa6.slint";
import { MdSpan, MdRow, CellRow, Col, CodeKeys, StatusLine, FindBar, Segments, MdView, TableGrid, CellBar, TypeChips } from "editor.slint";
export { TSpan, TRow, Mark, MdSpan, MdRow, CellRow, Col, TextMetrics, StripItem }

export { Theme, Scroll, Kit, KeyboardFocus }

// kind: "phone", "mass", "card", "rom", "ram"
export struct DriveRow { title: string, size: string, detail: string, used: float, kind: string, read-only: bool }
// detail: "4.1 MB · 3 Nov" (list); short: "3.1 MB" or "812 items" (grid). state: 0 a file or folder, 1 being copied
// here (progress 0..1), 2 just copied. section: a heading above the row (Recent's "Today"); note: orange text at the
// end ("3 days left"); hit/post: a search match, drawn as name · hit (accent) · post
export struct FileRow {
    name: string,
    detail: string,
    short: string,
    folder: bool,
    badge: string,
    colour: color,
    checked: bool,
    state: int,
    progress: float,
    section: string,
    note: string,
    hit: string,
    post: string,
    // FA5: an image's thumbnail, once the worker made it
    thumb: image,
    has-thumb: bool,
}

export struct ImgGroup { title: string, count: string, more: string, thumbs: [FileRow] }

// a round check box (selection)
component Check inherits Rectangle {
    in property <bool> on;
    width: 24 * Theme.dp;
    height: self.width;
    border-radius: self.width / 2;
    background: root.on ? Theme.accent : transparent;
    border-width: root.on ? 0 : 2 * Theme.dp;
    border-color: Theme.text-dim;
    if root.on: Glyph {
        source: @image-url("@neoui/icons/sys/check.svg");
        size: 16 * Theme.dp;
        colorize: white;
    }
}

// A compact pill (the paste bar, the toast, the clash dialog: files2-paste-bar, files2-clash): 40 dp, 15 dp text;
// primary = accent fill, else a field fill, or `flat` (text only).
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> flat;
    in property <bool> enabled: true;
    callback clicked();
    height: 40 * Theme.dp;
    width: label.preferred-width + (root.flat ? 24 : 32) * Theme.dp;
    border-radius: self.height / 2;
    opacity: root.enabled ? 1 : Theme.disabled;
    background: root.flat ? (touch.pressed ? Theme.pressed : transparent)
        : root.primary ? (touch.pressed ? Theme.accent.darker(20%) : Theme.accent)
        : (touch.pressed ? Theme.pressed : Theme.field);
    label := Text {
        text: root.text;
        color: root.flat && root.primary ? Theme.accent : root.flat ? Theme.text : white;
        font-size: 15 * Theme.dp;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A tap, or a 500 ms hold (selection) without the tap after it (ListRow's rule).
component Press inherits TouchArea {
    callback tapped();
    callback held();
    property <bool> fired;
    changed pressed => {
        if self.pressed {
            self.fired = false;
        }
    }
    clicked => {
        if !self.fired {
            root.tapped();
        }
    }
    Timer {
        interval: 500ms;
        running: root.pressed && !root.fired;
        triggered => {
            root.fired = true;
            root.held();
        }
    }
}

// one row of a folder (files2-folder-list): 64 dp, a 40 dp tile, name and detail, a lock / chevron / state on the right
component FileItem inherits Rectangle {
    in property <FileRow> item;
    in property <bool> selecting;
    in property <bool> locked;
    callback tapped();
    callback held();
    height: 64 * Theme.dp;
    background: press.pressed ? Theme.pressed : root.item.checked ? #3d8bfd1f : transparent;
    press := Press {
        tapped => {
            root.tapped();
        }
        held => {
            root.held();
        }
    }

    HorizontalLayout {
        padding-left: 16 * Theme.dp;
        padding-right: 16 * Theme.dp;
        spacing: 14 * Theme.dp;
        if root.selecting: VerticalLayout {
            alignment: center;
            Check {
                on: root.item.checked;
            }
        }
        VerticalLayout {
            alignment: center;
            width: 40 * Theme.dp;
            opacity: root.item.state == 1 ? 0.5 : 1;
            HorizontalLayout {
                alignment: center;
                if root.item.folder: FolderTile { }
                if !root.item.folder && !root.item.has-thumb: FTile {
                    badge: root.item.badge;
                    colour: root.item.colour;
                }
                if root.item.has-thumb: Thumb {
                    size: 40 * Theme.dp;
                    source: root.item.thumb;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3 * Theme.dp;
            horizontal-stretch: 1;
            if root.item.hit == "": Text {
                text: root.item.name;
                font-family: "DejaVu Sans";
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 500;
                overflow: elide;
            }
            if root.item.hit != "": HorizontalLayout {
                Text {
                    text: root.item.name;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                }

                Text {
                    text: root.item.hit;
                    font-family: "DejaVu Sans";
                    color: Theme.accent;
                    font-size: Theme.font-body;
                    font-weight: 500;
                }

                Text {
                    text: root.item.post;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            if root.item.note == "": Text {
                text: root.item.detail;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
            if root.item.note != "": HorizontalLayout {
                spacing: 4 * Theme.dp;
                Text {
                    text: root.item.detail + " ·";
                    font-family: "DejaVu Sans";
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                    overflow: elide;
                }

                Text {
                    text: root.item.note;
                    color: #f0a020;
                    font-size: Theme.font-label;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
            }
        }

        if root.item.state == 1: VerticalLayout {
            alignment: center;
            ProgressBar {
                width: 56 * Theme.dp;
                value: root.item.progress;
            }
        }
        if root.item.state == 2: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("@neoui/icons/sys/check.svg");
                size: 20 * Theme.dp;
                colorize: #22b46a;
            }
        }
        if root.locked && root.item.state == 0: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("@neoui/icons/sys/lock.svg");
                size: 16 * Theme.dp;
                colorize: Theme.text-dim;
            }
        }
        if root.item.folder && !root.selecting && !root.locked: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                size: 18 * Theme.dp;
                colorize: Theme.text-dim;
            }
        }
    }

    Rectangle {
        x: 70 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: #ffffff12;
    }
}

// one cell of the 3-column grid (files2-folder-grid): a 60 dp folder or a 56 dp file tile, the name, the detail
component FileCell inherits Rectangle {
    in property <FileRow> item;
    in property <bool> selecting;
    callback tapped();
    callback held();
    border-radius: 12 * Theme.dp;
    background: press.pressed ? Theme.pressed : root.item.checked ? #3d8bfd1f : transparent;
    press := Press {
        tapped => {
            root.tapped();
        }
        held => {
            root.held();
        }
    }

    VerticalLayout {
        padding-top: 10 * Theme.dp;
        spacing: 4 * Theme.dp;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            height: 60 * Theme.dp;
            VerticalLayout {
                alignment: center;
                if root.item.folder: FolderTile {
                    size: 60 * Theme.dp;
                }
                if !root.item.folder && !root.item.has-thumb: FTile {
                    size: 56 * Theme.dp;
                    badge: root.item.badge;
                    colour: root.item.colour;
                }
                if root.item.has-thumb: Thumb {
                    size: 60 * Theme.dp;
                    source: root.item.thumb;
                }
            }
        }

        Text {
            text: root.item.name;
            font-family: "DejaVu Sans";
            color: Theme.text;
            font-size: 13.5 * Theme.dp;
            font-weight: 500;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.item.short;
            color: Theme.text-dim;
            font-size: 12 * Theme.dp;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.selecting: Check {
        x: 8 * Theme.dp;
        y: 8 * Theme.dp;
        on: root.item.checked;
    }
}

// the drives card (files2-browse): a tile, "C: Phone memory" and its size, the usage line and bar
component DriveItem inherits Rectangle {
    in property <DriveRow> drive;
    in property <bool> last;
    callback tapped();
    height: (root.drive.read-only ? 76 : 86) * Theme.dp;
    background: touch.pressed ? Theme.pressed : transparent;
    touch := TouchArea {
        clicked => {
            root.tapped();
        }
    }

    HorizontalLayout {
        padding-left: 14 * Theme.dp;
        padding-right: 14 * Theme.dp;
        spacing: 14 * Theme.dp;
        VerticalLayout {
            alignment: center;
            DriveTile {
                kind: root.drive.kind;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4 * Theme.dp;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                Text {
                    text: root.drive.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.drive.read-only: VerticalLayout {
                    alignment: center;
                    Glyph {
                        source: @image-url("@neoui/icons/sys/lock.svg");
                        size: 14 * Theme.dp;
                        colorize: Theme.text-dim;
                    }
                }
                Text {
                    text: root.drive.size;
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.drive.detail;
                color: Theme.text-secondary;
                font-size: Theme.font-label;
                overflow: elide;
            }

            if !root.drive.read-only: Rectangle {
                height: 6 * Theme.dp;
                border-radius: self.height / 2;
                background: #ffffff1a;
                Rectangle {
                    x: 0;
                    width: parent.width * root.drive.used;
                    border-radius: parent.border-radius;
                    background: root.drive.kind == "mass" ? #7b6cf0 : root.drive.kind == "card" ? #22b46a : Theme.accent;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                size: 18 * Theme.dp;
                colorize: Theme.text-dim;
            }
        }
    }

    if !root.last: Rectangle {
        x: 68 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: #ffffff12;
    }
}

component SectionLabel inherits Text {
    color: Theme.text-dim;
    font-size: 12.5 * Theme.dp;
    font-weight: 600;
    letter-spacing: 0.8px;
}

// a section's label with a link at the end (files2-browse: FAVOURITES · Edit, RECENT · See all)
component HeadingLink inherits HorizontalLayout {
    in property <string> text;
    in property <string> link;
    callback clicked();
    height: 30 * Theme.dp;
    padding-left: 4 * Theme.dp;
    padding-top: 8 * Theme.dp;
    SectionLabel {
        text: root.text;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }

    Text {
        text: root.link;
        color: Theme.accent;
        font-size: 14 * Theme.dp;
        font-weight: 600;
        vertical-alignment: center;
        TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
}

// one choice in the Sort sheet: a radio and its label
component RadioRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback picked();
    height: 56 * Theme.dp;
    background: touch.pressed ? Theme.pressed : transparent;
    touch := TouchArea {
        clicked => {
            root.picked();
        }
    }

    HorizontalLayout {
        padding-left: 20 * Theme.dp;
        spacing: 16 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2 * Theme.dp;
                border-color: root.on ? Theme.accent : Theme.text-dim;
                if root.on: Rectangle {
                    width: 10 * Theme.dp;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                }
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }
}

component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 56 * Theme.dp;
    HorizontalLayout {
        padding-left: 20 * Theme.dp;
        padding-right: 20 * Theme.dp;
        spacing: 12 * Theme.dp;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2 * Theme.dp;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-body;
            }

            Text {
                text: root.hint;
                color: Theme.text-dim;
                font-size: 12.5 * Theme.dp;
            }
        }

        VerticalLayout {
            alignment: center;
            Switch {
                on: root.on;
                opacity: root.enabled ? 1 : 0.4;
                toggled(v) => {
                    root.toggled(v);
                }
                // System: shown, not changeable
                if !root.enabled: TouchArea { }
            }
        }
    }
}

export component FilesApp inherits Window {
    default-font-family: "NeoSans";
    background: Theme.bg;

    // "browse" (the drives), "folder" or "text"
    in property <string> view: "browse";
    in property <[DriveRow]> drives;
    // the open folder or file: its name (the header's title) and the breadcrumb's labels
    in property <string> name;
    in property <[string]> crumbs;
    in property <[FileRow]> rows;
    in property <bool> grid;
    in property <bool> read-only;
    in property <bool> show-hidden;
    // rows picked (selection mode, K03): how many
    in property <int> selected;
    // the Sort sheet
    in-out property <bool> sort-open;
    in property <int> sort-key;
    in property <bool> ascending: true;
    in property <bool> folders-first: true;
    // the paste bar (F06): "2 files to move", "from E:\Music", "Move here"; hidden while the action is ""
    in property <string> paste-title;
    in property <string> paste-from;
    in property <string> paste-action;
    // a copy or move running: the toast's text and progress (0..1); hidden while the text is ""
    in property <string> job-text;
    in property <float> job-progress;
    // a name clash: the question, the two versions, how many clashes this answer can cover
    in property <bool> clash-open;
    in property <string> clash-title;
    in property <string> clash-text;
    in property <int> clash-count;
    in-out property <bool> clash-all: true;
    // "" (none), "folder", "file" or "rename": a form page over the folder
    in property <string> form;
    in property <string> form-dir;
    in-out property <string> name-text;
    // Rename keeps the extension (files2-rename): ".flac", and what the file is
    in property <string> name-suffix;
    in property <string> form-detail;
    in property <string> form-badge;
    in property <color> form-colour;
    in property <bool> refreshing;
    // the system keyboard's height over the bottom of the surface, while a name is typed
    in property <length> kb-h;

    // FA3. tab: the footer's (0 Browse, 1 Recent, 2 Types); views "recent", "types", "type", "bin", "cleanup",
    // "review", "favs" besides "browse", "folder" and "text"
    in property <int> tab-index;
    in property <[FileRow]> favs;
    in property <[FileRow]> recent-strip;
    // the open selection holds exactly one item / one folder (the ⋮ offers Details / Add to Favourites)
    in property <bool> one-item;
    in property <bool> one-folder;
    // a list with nothing picked yet (the bin's ⋮ Select)
    in-out property <bool> picking;
    in property <string> empty-text;
    // files2-types and the type page (files2-type-docs)
    in property <string> types-used;
    in property <string> types-of;
    in property <[Seg]> types-bar;
    in property <[TypeTile]> types;
    in property <[string]> type-drives;
    in property <int> type-drive;
    in property <[string]> type-subs;
    in property <int> type-sub;
    in property <string> updating;
    // search (files2-search): the header's query, the scope chips, the filters sheet
    in-out property <bool> searching;
    in-out property <string> query;
    in property <[FileRow]> hits;
    in property <string> search-info;
    in property <bool> search-folder;
    in property <bool> can-search-folder;
    in property <int> filter-count;
    in-out property <bool> filters-open;
    in property <int> f-type;
    in property <int> f-size;
    in property <int> f-modified;
    in property <int> filter-results;
    // the bin (files2-bin) and Free up space (files2-cleanup)
    in property <string> info-title;
    in property <string> info-text;
    in property <string> can-free;
    in property <[CleanCard]> clean;
    // Details (files2-details)
    in-out property <bool> details-open;
    in property <FileRow> details-item;
    in property <string> details-kind;
    in property <[Detail]> details;
    in property <bool> details-attributes;
    in property <bool> d-read-only;
    in property <bool> d-hidden;
    in property <bool> d-system;

    // FA4: the text surface's window of rows (Rust lays out and colours them), the viewer and the editors
    in property <[TRow]> text-rows;
    in property <int> text-total;
    in property <int> text-gutter;
    in property <bool> text-cursor;
    in property <int> cursor-row;
    in property <int> cursor-x;
    in property <[Mark]> text-marks;
    in property <bool> text-handles;
    in property <int> a-row;
    in property <int> a-x;
    in property <int> b-row;
    in property <int> b-x;
    out property <int> text-cols: pane.cols;
    out property <int> text-visible: pane.visible-rows;
    in property <bool> wrap;
    // the viewer's bottom line ("Lines 1–14 of 1,204 · 64 KB · UTF-8"), the editor's ("Ln 13, Col 18 · UTF-8 · LF")
    in property <string> text-info;
    in property <string> status;
    in property <bool> editable;
    in property <bool> dirty;
    in property <bool> can-undo;
    // "code", "md" or "table"
    in property <string> edit-kind;
    in property <int> md-mode;
    in property <[MdRow]> md-lines;
    in-out property <bool> find-open;
    in-out property <string> find-text;
    in-out property <string> replace-text;
    in property <string> find-info;
    in property <[string]> table-heads;
    in property <[Col]> table-cols;
    in property <[CellRow]> table-cells;
    in property <int> sel-r: -1;
    in property <int> sel-c: -1;
    in-out property <string> cell-text;
    in property <string> cell-name;
    in property <int> new-type;

    callback drive(int);
    callback open-row(int);
    callback toggle(int);
    callback crumb(int);
    callback up();
    callback tab(int);
    callback menu(string);
    callback selection-action(int);
    callback selection-menu(string);
    callback clear-selection();
    callback new-folder();
    callback new-file();
    callback refresh();
    callback sort-chosen(int);
    callback ascending-changed(bool);
    callback folders-first-changed(bool);
    callback paste-cancel();
    callback paste-go();
    callback job-hide();
    callback clash-answer(int);
    callback form-cancel();
    callback form-save();
    callback fav(int);
    callback fav-remove(int);
    callback favs-edit();
    callback recent-open(int);
    callback see-all();
    callback type-open(int);
    callback type-drive-picked(int);
    callback type-sub-picked(int);
    callback searched(string);
    callback search-scope(bool);
    callback hit-open(int);
    callback filter-type(int);
    callback filter-size(int);
    callback filter-modified(int);
    callback filters-reset();
    callback review(int);
    callback details-read-only(bool);
    callback details-hidden(bool);
    callback text-scrolled(int);
    callback text-tapped(int, int);
    callback text-held(int, int);
    callback handle-moved(int, int, int);
    callback handle-done();
    callback edit();
    callback undo();
    callback save();
    callback code-key(string);
    callback wrap-toggled();
    callback find-edited(string);
    callback find-next();
    callback find-prev();
    callback replace-one();
    callback replace-all();
    callback md-picked(int);
    callback task-toggled(int);
    callback cell-picked(int, int);
    callback cell-done();
    callback new-type-picked(int);

    // FA5: views "image" (files2-view-image) and "image-edit" (files2-edit-image), over everything but the sheets
    in property <image> img;
    in property <string> img-counter;
    in property <string> img-info;
    in property <string> img-note;
    in property <float> img-zoom: 1;
    in property <length> img-pan-x;
    in property <length> img-pan-y;
    in property <bool> img-chrome: true;
    in property <bool> img-hint;
    in property <bool> img-editable;
    in property <[StripItem]> img-strip;
    // files2-type-images: the Images type by folder
    in property <[ImgGroup]> img-groups;
    in property <int> img-current;
    in property <[string]> img-menu: ["Details"];
    in property <bool> img-can-undo;
    in property <bool> img-can-redo;
    in property <bool> img-cropping;
    in property <length> crop-x;
    in property <length> crop-y;
    in property <length> crop-w;
    in property <length> crop-h;
    in property <string> crop-label;
    in property <int> crop-ratio;
    in property <string> img-save-note;
    in property <bool> img-saving;
    in-out property <bool> resize-open;
    in property <[string]> resize-choices;
    in property <int> resize-current;
    out property <float> img-fit: viewer.fit;
    // how far the folder and the listing views scrolled, and their height (which thumbnails to make)
    out property <length> folder-top: -folder-list.content-y;
    out property <length> folder-h: folder-list.height;
    out property <length> list-top: -list-view.content-y;
    out property <length> list-h: list-view.height;
    out property <length> img-box-w: editor.box-w;
    out property <length> img-box-h: editor.box-h;
    callback img-menu-picked(int);
    // a thumbnail of a group (the last one, "+804", opens the folder)
    callback group-picked(int, int);
    callback img-strip-picked(int);
    callback img-tapped();
    callback img-double-tapped(length, length);
    callback img-dragged(length, length);
    callback img-released(length, length);
    callback img-edit-menu(int);
    callback img-redo();
    callback img-rotate();
    callback img-crop-mode();
    callback img-resize();
    callback img-flip();
    callback img-save();
    callback crop-ratio-picked(int);
    callback crop-start(int);
    callback crop-drag(int, length, length);
    callback crop-done();
    callback resize-chosen(int);

    // FA6: view "archive" (files2-zip-browse) lists inside an archive; the bar under it
    in property <string> archive-count;
    in property <string> archive-sub;
    // files2-extract: the sheet, its ways (Extract here's folder; Browse inside for a zip or tar), and the job's card
    in-out property <bool> extract-open;
    in property <string> extract-title;
    in property <string> extract-info;
    in property <string> extract-here;
    in property <bool> extract-browse: true;
    in property <bool> extract-busy;
    in property <string> job-title;
    in property <string> job-detail;
    // files2-compress (form "compress"): its title, the format (0 zip, 1 tar.gz), Save in, the items and the estimate
    in property <string> compress-title;
    in property <int> compress-format;
    in property <string> compress-dir;
    in property <string> compress-free;
    in property <string> compress-total;
    in property <[PackItem]> compress-items;
    in property <string> compress-note;
    // view "pick-folder": Extract to… and Save in
    in property <string> picker-title;
    in property <[string]> picker-drives;
    in property <int> picker-drive;
    in property <[string]> picker-crumbs;
    in property <[PackItem]> picker-rows;
    in property <string> picker-action;
    in property <string> picker-info;
    in property <bool> picker-can;
    callback extract-way(int);
    callback extract-to();
    callback extract-all();
    callback job-cancel();
    callback compress-format-picked(int);
    callback save-in();
    callback picker-cancel();
    callback picker-done();
    callback picker-drive-picked(int);
    callback picker-crumb(int);
    callback picker-open(int);
    callback picker-new-folder();

    // keep a row in view (the cursor after a key, a find match)
    public function text-show-row(r: int) {
        pane.show-row(r);
    }
    public function text-top() {
        pane.to-top();
    }

    property <[string]> root-menu: ["Recycle bin", "Free up space", root.show-hidden ? "Hide hidden files" : "Show hidden files"];
    property <[string]> folder-menu: root.read-only ? [
        "Sort by", root.grid ? "List view" : "Grid view", root.show-hidden ? "Hide hidden" : "Show hidden", "Details"
    ] : [
        "New folder", "New file", "Sort by", root.grid ? "List view" : "Grid view",
        root.show-hidden ? "Hide hidden" : "Show hidden", "Details"
    ];
    property <[string]> pick-menu: root.read-only ? (root.one-item ? ["Compress", "Details", "Select all"] : ["Compress", "Select all"])
        : root.one-folder ? ["Move", "Rename", "Compress", "Add to Favourites", "Details", "Select all"]
        : root.one-item ? ["Move", "Rename", "Compress", "Details", "Select all"] : ["Move", "Compress", "Select all"];
    property <[string]> bin-menu: ["Empty bin", "Select"];
    property <bool> selecting: root.selected > 0 || root.picking;
    property <bool> tab-root: root.view == "browse" || root.view == "recent" || root.view == "types";
    property <bool> footer: root.form == "" && !root.selecting && !root.searching
        && (root.tab-root || root.view == "folder");
    property <bool> listing: root.view == "recent" || root.view == "type" || root.view == "bin" || root.view == "review";

    Alphabets { }

    VerticalLayout {
        if root.tab-root: Header {
            title: "Files";
            searching <=> root.searching;
            query <=> root.query;
            searched(t) => {
                root.searched(t);
            }
            menu: root.root-menu;
            menu-picked(i) => {
                root.menu(root.root-menu[i]);
            }
            top => {
                browse-list.to-top();
                list-view.to-top();
            }
        }
        if root.view == "folder": SubHeader {
            title: root.name;
            title-font: "DejaVu Sans";
            searching <=> root.searching;
            query <=> root.query;
            searched(t) => {
                root.searched(t);
            }
            menu: root.folder-menu;
            selected: root.selected;
            selection-actions: [
                { icon: @image-url("icons/copy.svg"), label: "Copy" },
                { icon: @image-url("@neoui/icons/sys/delete.svg"), label: "Delete", disabled: root.read-only },
            ];
            selection-menu: root.pick-menu;
            back => {
                root.up();
            }
            menu-picked(i) => {
                root.menu(root.folder-menu[i]);
            }
            selection-action(i) => {
                root.selection-action(i);
            }
            selection-menu-picked(i) => {
                root.selection-menu(root.pick-menu[i]);
            }
            selection-closed => {
                root.clear-selection();
            }
            top => {
                folder-list.to-top();
            }
        }
        // files2-zip-browse: [← backup-2026.zip · search · ⋮]; a pick extracts
        if root.view == "archive": SubHeader {
            title: root.name;
            title-font: "DejaVu Sans";
            searching <=> root.searching;
            query <=> root.query;
            searched(t) => {
                root.searched(t);
            }
            menu: ["Select all", "Details"];
            selected: root.selected;
            selection-actions: [{ icon: @image-url("icons/unarchive.svg"), label: "Extract" }];
            selection-menu: ["Select all"];
            back => {
                root.up();
            }
            menu-picked(i) => {
                root.menu(["Select all", "Details"][i]);
            }
            selection-action(i) => {
                root.selection-action(i);
            }
            selection-menu-picked(i) => {
                root.selection-menu("Select all");
            }
            selection-closed => {
                root.clear-selection();
            }
            top => {
                folder-list.to-top();
            }
        }
        // files2-view-text: [← name · edit · ⋮]
        if root.view == "text": SubHeader {
            title: root.name;
            title-font: "DejaVu Sans";
            search: false;
            actions: root.editable ? [{ icon: @image-url("@neoui/icons/sys/edit.svg"), label: "Edit" }] : [];
            menu: [root.wrap ? "No wrap" : "Wrap lines", "Details"];
            back => {
                root.up();
            }
            action(i) => {
                root.edit();
            }
            menu-picked(i) => {
                root.menu([root.wrap ? "No wrap" : "Wrap lines", "Details"][i]);
            }
            top => {
                pane.to-top();
            }
        }
        // files2-edit-code: [← name ● · undo · save · ⋮]
        if root.view == "edit": SubHeader {
            title: root.dirty ? root.name + " ●" : root.name;
            title-font: "DejaVu Sans";
            search: false;
            actions: [
                { icon: @image-url("icons/undo.svg"), label: "Undo", disabled: !root.can-undo },
                { icon: @image-url("icons/save.svg"), label: "Save", disabled: !root.dirty },
            ];
            menu: root.edit-kind == "table" ? ["Add row", "Add column", "Delete row", "Details"]
                : ["Find and replace", root.wrap ? "No wrap" : "Wrap lines", "Details"];
            back => {
                root.up();
            }
            action(i) => {
                if i == 0 {
                    root.undo();
                } else {
                    root.save();
                }
            }
            menu-picked(i) => {
                root.menu(root.edit-kind == "table" ? ["Add row", "Add column", "Delete row", "Details"][i]
                    : ["Find and replace", root.wrap ? "No wrap" : "Wrap lines", "Details"][i]);
            }
        }
        if root.view == "type": SubHeader {
            title: root.name;
            searching <=> root.searching;
            query <=> root.query;
            searched(t) => {
                root.searched(t);
            }
            back => {
                root.up();
            }
            top => {
                list-view.to-top();
            }
        }
        // the bin and the Free up space reviews pick rows; Restore / Delete forever, or Delete (to the bin)
        if root.view == "bin" || root.view == "review": SubHeader {
            title: root.name;
            search: false;
            menu: root.view == "bin" ? root.bin-menu : ["Select all"];
            selected: root.selected;
            selecting: root.picking;
            selection-actions: root.view == "bin" ? [
                { icon: @image-url("@neoui/icons/sys/recents.svg"), label: "Restore" },
                { icon: @image-url("@neoui/icons/sys/delete.svg"), label: "Delete forever" },
            ] : [
                { icon: @image-url("@neoui/icons/sys/delete.svg"), label: "Delete" },
            ];
            selection-menu: ["Select all"];
            back => {
                root.up();
            }
            menu-picked(i) => {
                root.menu(root.view == "bin" ? root.bin-menu[i] : "Select all");
            }
            selection-action(i) => {
                root.selection-action(i);
            }
            selection-menu-picked(i) => {
                root.selection-menu("Select all");
            }
            selection-closed => {
                root.clear-selection();
            }
            top => {
                list-view.to-top();
            }
        }
        if root.view == "cleanup" || root.view == "favs": SubHeader {
            title: root.view == "cleanup" ? "Free up space" : "Favourites";
            search: false;
            back => {
                root.up();
            }
        }

        // the breadcrumb (F05): the drive, then each folder; the last is where you are
        if root.view == "folder" || root.view == "archive": HorizontalLayout {
            height: 40 * Theme.dp;
            padding-left: 12 * Theme.dp;
            padding-right: 12 * Theme.dp;
            spacing: 4 * Theme.dp;
            alignment: start;
            for c[i] in root.crumbs: HorizontalLayout {
                spacing: 4 * Theme.dp;
                if i > 0: VerticalLayout {
                    alignment: center;
                    Glyph {
                        source: @image-url("@neoui/icons/sys/chevron_right.svg");
                        size: 14 * Theme.dp;
                        colorize: Theme.text-dim;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        property <bool> here: i == root.crumbs.length - 1;
                        height: 28 * Theme.dp;
                        width: crumb-text.preferred-width + 20 * Theme.dp;
                        border-radius: self.height / 2;
                        background: crumb-touch.pressed ? Theme.pressed : self.here ? Theme.tab-pill : Theme.field;
                        crumb-text := Text {
                            text: c;
                            font-family: "DejaVu Sans";
                            color: parent.here ? Theme.text : Theme.text-secondary;
                            font-size: 13.5 * Theme.dp;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        crumb-touch := TouchArea {
                            clicked => {
                                root.crumb(i);
                            }
                        }
                    }
                }
            }
        }

        // Z: and other read-only drives (files2-rom)
        if root.view == "folder" && root.read-only && !root.selecting: Rectangle {
            height: banner.preferred-height + 12 * Theme.dp;
            Rectangle {
                x: 12 * Theme.dp;
                y: 4 * Theme.dp;
                width: parent.width - 24 * Theme.dp;
                height: banner.preferred-height;
                border-radius: Theme.radius;
                background: Theme.card;
                border-width: max(1px, Theme.dp / 2);
                border-color: #ffffff14;
                banner := HorizontalLayout {
                    padding: 14 * Theme.dp;
                    spacing: 12 * Theme.dp;
                    VerticalLayout {
                        alignment: start;
                        Glyph {
                            source: @image-url("@neoui/icons/sys/lock.svg");
                            size: 20 * Theme.dp;
                            colorize: #e2a92a;
                        }
                    }
                    VerticalLayout {
                        spacing: 3 * Theme.dp;
                        Text {
                            text: "Read-only drive";
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 600;
                        }

                        Text {
                            text: "You can open and copy these files, not change or delete them.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-label;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        if root.view == "archive" && !root.selecting: ViewOnly { }

        // the views share the rest of the surface; the hidden ones stay (their ids are used above)
        Rectangle {
            vertical-stretch: 1;
            browse-list := NeoList {
                visible: root.view == "browse" && !root.searching;
                VerticalLayout {
                    alignment: start;
                    padding-left: 12 * Theme.dp;
                    padding-right: 12 * Theme.dp;
                    padding-top: 6 * Theme.dp;
                    spacing: 8 * Theme.dp;
                    SectionLabel {
                        x: 4 * Theme.dp;
                        text: "DRIVES";
                    }

                    Rectangle {
                        border-radius: Theme.radius;
                        background: Theme.card;
                        border-width: max(1px, Theme.dp / 2);
                        border-color: #ffffff14;
                        clip: true;
                        VerticalLayout {
                            for d[i] in root.drives: DriveItem {
                                drive: d;
                                last: i == root.drives.length - 1;
                                tapped => {
                                    root.drive(i);
                                }
                            }
                        }
                    }

                    // files2-browse: Favourites (up to 3 shown) and the last 4 files opened
                    if root.favs.length > 0: HeadingLink {
                        text: "FAVOURITES";
                        link: "Edit";
                        clicked => {
                            root.favs-edit();
                        }
                    }
                    if root.favs.length > 0: HorizontalLayout {
                        spacing: 8 * Theme.dp;
                        for f[i] in root.favs: Rectangle {
                            horizontal-stretch: 1;
                            preferred-width: 0;
                            min-width: 0;
                            height: 82 * Theme.dp;
                            border-radius: Theme.radius;
                            background: fav-touch.pressed ? Theme.pressed : Theme.card;
                            border-width: max(1px, Theme.dp / 2);
                            border-color: #ffffff14;
                            fav-touch := TouchArea {
                                clicked => {
                                    root.fav(i);
                                }
                            }
                            VerticalLayout {
                                padding: 12 * Theme.dp;
                                spacing: 2 * Theme.dp;
                                HorizontalLayout {
                                    alignment: start;
                                    FolderTile {
                                        size: 30 * Theme.dp;
                                    }
                                }

                                Text {
                                    text: f.name;
                                    font-family: "DejaVu Sans";
                                    color: Theme.text;
                                    font-size: 14.5 * Theme.dp;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: f.detail;
                                    color: Theme.text-dim;
                                    font-size: 12 * Theme.dp;
                                }
                            }
                        }
                    }
                    if root.recent-strip.length > 0: HeadingLink {
                        text: "RECENT";
                        link: "See all";
                        clicked => {
                            root.see-all();
                        }
                    }
                    if root.recent-strip.length > 0: HorizontalLayout {
                        spacing: 8 * Theme.dp;
                        for r[i] in root.recent-strip: VerticalLayout {
                            horizontal-stretch: 1;
                            preferred-width: 0;
                            min-width: 0;
                            spacing: 6 * Theme.dp;
                            Rectangle {
                                height: 64 * Theme.dp;
                                border-radius: Theme.radius;
                                background: strip-touch.pressed ? Theme.pressed : Theme.card;
                                border-width: max(1px, Theme.dp / 2);
                                border-color: #ffffff14;
                                strip-touch := TouchArea {
                                    clicked => {
                                        root.recent-open(i);
                                    }
                                }
                                FTile {
                                    badge: r.badge;
                                    colour: r.colour;
                                }
                            }

                            Text {
                                text: r.name;
                                font-family: "DejaVu Sans";
                                color: Theme.text;
                                font-size: 12.5 * Theme.dp;
                                font-weight: 500;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // Recent, a type's files, the bin and a Free up space review: rows with headings
            list-view := NeoList {
                visible: root.listing && !root.searching;
                selected: root.selected;
                VerticalLayout {
                    alignment: start;
                    // the drive chips scroll sideways when they don't fit (they would widen the page)
                    if root.view == "type": Flickable {
                        visible: root.type-subs.length == 0;
                        height: root.type-subs.length == 0 ? drive-chips.preferred-height : 0;
                        content-width: drive-chips.preferred-width;
                        drive-chips := HorizontalLayout {
                            padding: 12 * Theme.dp;
                            spacing: 8 * Theme.dp;
                            alignment: start;
                            for t[i] in root.type-drives: Pick {
                                text: t;
                                on: i == root.type-drive;
                                check: i == 0;
                                clicked => {
                                    root.type-drive-picked(i);
                                }
                            }
                        }
                    }
                    if root.view == "type" && root.type-subs.length > 0: HorizontalLayout {
                        padding: 12 * Theme.dp;
                        spacing: 8 * Theme.dp;
                        alignment: start;
                        for t[i] in root.type-subs: Pick {
                            text: t;
                            on: i == root.type-sub;
                            check: i == 0;
                            clicked => {
                                root.type-sub-picked(i);
                            }
                        }
                    }
                    // files2-type-images: by folder, eight thumbnails in four columns, the last "+804"
                    if root.view == "type": VerticalLayout {
                        for g[gi] in root.img-groups: VerticalLayout {
                            HorizontalLayout {
                                height: 38 * Theme.dp;
                                padding-left: 16 * Theme.dp;
                                padding-bottom: 8 * Theme.dp;
                                spacing: 6 * Theme.dp;
                                alignment: start;
                                Text {
                                    text: g.title;
                                    font-family: "DejaVu Sans";
                                    color: Theme.text-secondary;
                                    font-size: 13.5 * Theme.dp;
                                    font-weight: 600;
                                    vertical-alignment: bottom;
                                }
                                Text {
                                    text: "· " + g.count;
                                    color: Theme.text-dim;
                                    font-size: 13.5 * Theme.dp;
                                    font-weight: 500;
                                    vertical-alignment: bottom;
                                }
                            }
                            Rectangle {
                                property <length> gap: 4 * Theme.dp;
                                property <length> cell: (self.width - 24 * Theme.dp - 3 * self.gap) / 4;
                                height: Math.ceil(g.thumbs.length / 4) * (self.cell + self.gap);
                                for t[i] in g.thumbs: Rectangle {
                                    x: 12 * Theme.dp + Math.mod(i, 4) * (parent.cell + parent.gap);
                                    y: Math.floor(i / 4) * (parent.cell + parent.gap);
                                    width: parent.cell;
                                    height: parent.cell;
                                    border-radius: 6 * Theme.dp;
                                    clip: true;
                                    background: #2a2e35;
                                    if t.has-thumb: Image {
                                        width: 100%;
                                        height: 100%;
                                        source: t.thumb;
                                        image-fit: cover;
                                    }
                                    if !t.has-thumb: FTile {
                                        size: 40 * Theme.dp;
                                        badge: t.badge;
                                        colour: t.colour;
                                    }
                                    if i == g.thumbs.length - 1 && g.more != "": Rectangle {
                                        background: #000000a6;
                                        Text {
                                            text: g.more;
                                            color: white;
                                            font-size: 16 * Theme.dp;
                                            font-weight: 600;
                                        }
                                    }
                                    TouchArea {
                                        clicked => {
                                            root.group-picked(gi, i);
                                        }
                                    }
                                }
                            }
                        }
                    }
                    if root.info-title != "" && (root.view == "bin" || root.view == "review"): VerticalLayout {
                        padding: 12 * Theme.dp;
                        InfoCard {
                            title: root.info-title;
                            text: root.info-text;
                        }
                    }
                    if root.rows.length == 0 && root.empty-text != "": Text {
                        height: 160 * Theme.dp;
                        text: root.empty-text;
                        color: Theme.text-dim;
                        font-size: 15 * Theme.dp;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    for f[i] in root.rows: VerticalLayout {
                        if f.section != "": SectionLabel {
                            height: 36 * Theme.dp;
                            x: 16 * Theme.dp;
                            text: f.section;
                            vertical-alignment: center;
                        }
                        FileItem {
                            item: f;
                            selecting: root.selecting && (root.view == "bin" || root.view == "review");
                            held => {
                                if root.view == "bin" || root.view == "review" {
                                    root.toggle(i);
                                }
                            }
                            tapped => {
                                if root.selecting && (root.view == "bin" || root.view == "review") {
                                    root.toggle(i);
                                } else {
                                    root.open-row(i);
                                }
                            }
                        }
                    }
                    if root.updating != "": Text {
                        height: 40 * Theme.dp;
                        text: root.updating;
                        color: Theme.text-dim;
                        font-size: 13 * Theme.dp;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // files2-types: the used card and the 2 x 4 tiles
            NeoList {
                visible: root.view == "types" && !root.searching;
                VerticalLayout {
                    alignment: start;
                    padding: 12 * Theme.dp;
                    spacing: 8 * Theme.dp;
                    UsedCard {
                        used: root.types-used;
                        of: root.types-of;
                        segs: root.types-bar;
                    }

                    for r in 4: HorizontalLayout {
                        spacing: 8 * Theme.dp;
                        if r * 2 < root.types.length: GroupTile {
                            tile: root.types[r * 2];
                            tapped => {
                                root.type-open(r * 2);
                            }
                        }
                        if r * 2 + 1 < root.types.length: GroupTile {
                            tile: root.types[r * 2 + 1];
                            tapped => {
                                root.type-open(r * 2 + 1);
                            }
                        }
                    }
                    if root.updating != "": Text {
                        text: root.updating;
                        color: Theme.text-dim;
                        font-size: 13 * Theme.dp;
                        horizontal-alignment: center;
                    }
                }
            }

            // files2-cleanup: the drives, what can be freed, four reviews
            NeoList {
                visible: root.view == "cleanup";
                VerticalLayout {
                    alignment: start;
                    padding: 12 * Theme.dp;
                    spacing: 10 * Theme.dp;
                    Rectangle {
                        border-radius: Theme.radius;
                        background: Theme.card;
                        border-width: max(1px, Theme.dp / 2);
                        border-color: #ffffff14;
                        clip: true;
                        // files2-cleanup: title · "12.4 GB of 41.8 GB", the bar, then what is free (size and detail)
                        VerticalLayout {
                            for d[i] in root.drives: VerticalLayout {
                                padding: 16 * Theme.dp;
                                spacing: 8 * Theme.dp;
                                HorizontalLayout {
                                    Text {
                                        text: d.title;
                                        color: Theme.text;
                                        font-size: 15 * Theme.dp;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: d.size;
                                        color: Theme.text-secondary;
                                        font-size: 13.5 * Theme.dp;
                                    }
                                }

                                Rectangle {
                                    height: 6 * Theme.dp;
                                    border-radius: self.height / 2;
                                    background: #ffffff1a;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * d.used;
                                        border-radius: parent.border-radius;
                                        background: d.kind == "phone" ? #3d8bfd : #22b46a;
                                    }
                                }

                                Text {
                                    text: d.detail;
                                    color: Theme.text-dim;
                                    font-size: 13 * Theme.dp;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-top: 6 * Theme.dp;
                        padding-left: 4 * Theme.dp;
                        spacing: 8 * Theme.dp;
                        alignment: start;
                        Text {
                            text: root.can-free;
                            color: Theme.text;
                            font-size: 22 * Theme.dp;
                            font-weight: 700;
                        }

                        Text {
                            text: root.updating != "" ? root.updating : "can be freed";
                            color: Theme.text-secondary;
                            font-size: 14 * Theme.dp;
                            vertical-alignment: bottom;
                        }
                    }

                    for c[i] in root.clean: CleanItem {
                        card: c;
                        review => {
                            root.review(i);
                        }
                    }
                }
            }

            // Favourites › Edit: ✕ takes one off
            NeoList {
                visible: root.view == "favs";
                VerticalLayout {
                    alignment: start;
                    if root.favs.length == 0: Text {
                        height: 160 * Theme.dp;
                        text: "No favourites. Long-press a folder, then ⋮ › Add to Favourites.";
                        color: Theme.text-dim;
                        font-size: 15 * Theme.dp;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    for f[i] in root.favs: HorizontalLayout {
                        height: 64 * Theme.dp;
                        padding-left: 16 * Theme.dp;
                        padding-right: 8 * Theme.dp;
                        spacing: 14 * Theme.dp;
                        VerticalLayout {
                            alignment: center;
                            FolderTile { }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: f.name;
                                font-family: "DejaVu Sans";
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 500;
                                overflow: elide;
                            }

                            Text {
                                text: f.detail;
                                font-family: "DejaVu Sans";
                                color: Theme.text-dim;
                                font-size: Theme.font-label;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            width: 48 * Theme.dp;
                            background: x-touch.pressed ? Theme.pressed : transparent;
                            border-radius: self.width / 2;
                            x-touch := TouchArea {
                                clicked => {
                                    root.fav-remove(i);
                                }
                            }
                            Glyph {
                                source: @image-url("@neoui/icons/sys/close.svg");
                                size: 20 * Theme.dp;
                                colorize: Theme.text-secondary;
                            }
                        }
                    }
                }
            }

            // files2-search: scope chips and Filters, the count, the hits (a tap opens; a folder opens there)
            NeoList {
                visible: root.searching;
                VerticalLayout {
                    alignment: start;
                    HorizontalLayout {
                        padding: 12 * Theme.dp;
                        spacing: 8 * Theme.dp;
                        Pick {
                            text: "All drives";
                            on: !root.search-folder;
                            clicked => {
                                root.search-scope(false);
                            }
                        }

                        if root.can-search-folder: Pick {
                            text: "This folder";
                            on: root.search-folder;
                            clicked => {
                                root.search-scope(true);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Pick {
                            text: "Filters";
                            check: false;
                            has-icon: true;
                            icon: @image-url("@neoui/icons/sys/filter.svg");
                            count: root.filter-count;
                            clicked => {
                                root.filters-open = true;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16 * Theme.dp;
                        padding-right: 16 * Theme.dp;
                        height: 28 * Theme.dp;
                        Text {
                            text: root.search-info;
                            color: Theme.text-dim;
                            font-size: 13 * Theme.dp;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    for f[i] in root.hits: FileItem {
                        item: f;
                        tapped => {
                            root.hit-open(i);
                        }
                    }
                }
            }

            // files come from outside (K03): pull to list the folder again
            folder-list := NeoList {
                // an archive filters its rows while searching
                visible: (root.view == "folder" && !root.searching) || root.view == "archive";
                pull-refresh: root.view == "folder";
                refreshing: root.refreshing;
                selected: root.selected;
                refresh => {
                    root.refresh();
                }
                VerticalLayout {
                    alignment: start;
                    // files2-folder-empty
                    if root.rows.length == 0 && root.view == "folder": VerticalLayout {
                        padding-top: 72 * Theme.dp;
                        padding-left: 32 * Theme.dp;
                        padding-right: 32 * Theme.dp;
                        spacing: 14 * Theme.dp;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 120 * Theme.dp;
                                height: self.width;
                                border-radius: self.width / 2;
                                background: Theme.card;
                                FolderTile {
                                    size: 64 * Theme.dp;
                                }
                            }
                        }

                        Text {
                            text: "This folder is empty";
                            color: Theme.text;
                            font-size: 18 * Theme.dp;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.read-only ? "" : "Make a folder or a file here, or paste files you copied from another folder.";
                            color: Theme.text-secondary;
                            font-size: 14 * Theme.dp;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        if !root.read-only: HorizontalLayout {
                            alignment: center;
                            spacing: 10 * Theme.dp;
                            Button {
                                text: "New folder";
                                icon: @image-url("@neoui/icons/sys/add.svg");
                                has-icon: true;
                                clicked => {
                                    root.new-folder();
                                }
                            }

                            Button {
                                text: "New file";
                                primary: false;
                                clicked => {
                                    root.new-file();
                                }
                            }
                        }
                    }
                    if !root.grid: VerticalLayout {
                        for f[i] in root.rows: FileItem {
                            item: f;
                            selecting: root.selecting;
                            locked: root.read-only && root.view == "folder";
                            held => {
                                root.toggle(i);
                            }
                            tapped => {
                                if root.selecting {
                                    root.toggle(i);
                                } else {
                                    root.open-row(i);
                                }
                            }
                        }
                    }
                    if root.grid: Rectangle {
                        property <length> cell-w: (self.width - 16 * Theme.dp) / 3;
                        property <length> cell-h: 124 * Theme.dp;
                        height: Math.ceil(root.rows.length / 3) * self.cell-h + 8 * Theme.dp;
                        for f[i] in root.rows: FileCell {
                            x: 8 * Theme.dp + Math.mod(i, 3) * parent.cell-w;
                            y: Math.floor(i / 3) * parent.cell-h;
                            width: parent.cell-w;
                            height: parent.cell-h;
                            item: f;
                            selecting: root.selecting;
                            held => {
                                root.toggle(i);
                            }
                            tapped => {
                                if root.selecting {
                                    root.toggle(i);
                                } else {
                                    root.open-row(i);
                                }
                            }
                        }
                    }
                    // files2-paste-bar: where to go next
                    if root.paste-action != "" && root.rows.length > 0 && root.rows.length < 6: VerticalLayout {
                        padding-top: 120 * Theme.dp;
                        padding-left: 40 * Theme.dp;
                        padding-right: 40 * Theme.dp;
                        spacing: 10 * Theme.dp;
                        HorizontalLayout {
                            alignment: center;
                            Glyph {
                                source: @image-url("icons/move.svg");
                                size: 28 * Theme.dp;
                                colorize: Theme.text-dim;
                            }
                        }

                        Text {
                            text: "Open the folder you want, then tap " + root.paste-action + ". Tabs and drives still work.";
                            color: Theme.text-dim;
                            font-size: 13.5 * Theme.dp;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    // room for the toast and the paste bar over the last rows
                    Rectangle {
                        height: (root.job-text != "" ? 72 : 0) * Theme.dp;
                    }
                }
            }

            // the viewer and the editors (FA4): one text surface, with Preview or the table over it
            VerticalLayout {
                visible: root.view == "text" || root.view == "edit";
                if root.view == "text": HorizontalLayout {
                    padding: 10 * Theme.dp;
                    padding-left: 12 * Theme.dp;
                    alignment: start;
                    Pick {
                        text: "Wrap";
                        on: root.wrap;
                        check: false;
                        has-icon: true;
                        icon: @image-url("@neoui/icons/sys/sort.svg");
                        clicked => {
                            root.wrap-toggled();
                        }
                    }
                }
                if root.view == "edit" && root.find-open: FindBar {
                    find <=> root.find-text;
                    replace <=> root.replace-text;
                    info: root.find-info;
                    find-edited(t) => {
                        root.find-edited(t);
                    }
                    next => {
                        root.find-next();
                    }
                    prev => {
                        root.find-prev();
                    }
                    replace-one => {
                        root.replace-one();
                    }
                    replace-all => {
                        root.replace-all();
                    }
                }
                if root.view == "edit" && root.edit-kind == "md": Segments {
                    items: ["Edit", "Preview"];
                    current: root.md-mode;
                    picked(i) => {
                        root.md-picked(i);
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    pane := TextPane {
                        width: parent.width;
                        height: parent.height;
                        rows: root.text-rows;
                        total-rows: root.text-total;
                        gutter: root.text-gutter;
                        show-cursor: root.text-cursor;
                        cursor-row: root.cursor-row;
                        cursor-x: root.cursor-x;
                        marks: root.text-marks;
                        handles: root.text-handles;
                        a-row: root.a-row;
                        a-x: root.a-x;
                        b-row: root.b-row;
                        b-x: root.b-x;
                        scrolled(r) => {
                            root.text-scrolled(r);
                        }
                        tapped(r, x) => {
                            root.text-tapped(r, x);
                        }
                        held(r, x) => {
                            root.text-held(r, x);
                        }
                        handle-moved(w, r, x) => {
                            root.handle-moved(w, r, x);
                        }
                        handle-done => {
                            root.handle-done();
                        }
                    }

                    if root.view == "edit" && root.edit-kind == "md" && root.md-mode == 1: Rectangle {
                        background: Theme.bg;
                        MdView {
                            lines: root.md-lines;
                            task-toggled(i) => {
                                root.task-toggled(i);
                            }
                        }
                    }
                    if root.view == "edit" && root.edit-kind == "table": TableGrid {
                        heads: root.table-heads;
                        cols: root.table-cols;
                        cells: root.table-cells;
                        sel-r: root.sel-r;
                        sel-c: root.sel-c;
                        picked(r, c) => {
                            root.cell-picked(r, c);
                        }
                    }
                }

                if root.view == "text": Rectangle {
                    height: 36 * Theme.dp;
                    background: Theme.bg;
                    Text {
                        x: 16 * Theme.dp;
                        text: root.text-info;
                        color: Theme.text-dim;
                        font-size: 12.5 * Theme.dp;
                    }
                }
                if root.view == "edit" && root.kb-h > 0 && root.edit-kind == "table" && root.sel-r >= 0: CellBar {
                    name: root.cell-name;
                    value <=> root.cell-text;
                    done => {
                        root.cell-done();
                    }
                }
                if root.view == "edit" && root.kb-h > 0 && root.edit-kind != "table" && !root.find-open: CodeKeys {
                    key(k) => {
                        root.code-key(k);
                    }
                }
                if root.view == "edit" && root.kb-h == 0 && root.edit-kind != "table": StatusLine {
                    text: root.status;
                    wrap: root.wrap;
                    wrap-toggled => {
                        root.wrap-toggled();
                    }
                }
                // the system keyboard lies over the bottom of the surface
                if root.view == "edit": Rectangle {
                    height: root.kb-h;
                }
            }

            // a copy or move (files2-progress): over the bottom of the list, Hide moves it to the shade only
            if root.job-text != "": Rectangle {
                x: 12 * Theme.dp;
                y: parent.height - self.height - 12 * Theme.dp;
                width: parent.width - 24 * Theme.dp;
                height: 56 * Theme.dp;
                border-radius: Theme.radius;
                background: #2a2e35;
                clip: true;
                HorizontalLayout {
                    padding-left: 16 * Theme.dp;
                    padding-right: 8 * Theme.dp;
                    spacing: 12 * Theme.dp;
                    VerticalLayout {
                        alignment: center;
                        Glyph {
                            source: @image-url("icons/copy.svg");
                            size: 20 * Theme.dp;
                            colorize: Theme.text-secondary;
                        }
                    }
                    Text {
                        text: root.job-text;
                        color: Theme.text;
                        font-size: 14.5 * Theme.dp;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: "Hide";
                            flat: true;
                            primary: true;
                            clicked => {
                                root.job-hide();
                            }
                        }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    height: 3 * Theme.dp;
                    width: parent.width * max(0, min(1, root.job-progress));
                    background: Theme.accent;
                }
            }
        }

        // the paste bar (F06): above the footer, so tabs and drives still work while it waits
        if root.paste-action != "" && root.form == "": Rectangle {
            height: 60 * Theme.dp;
            background: Theme.card;
            Rectangle {
                y: 0;
                height: max(1px, Theme.dp / 2);
                background: #ffffff12;
            }

            HorizontalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 6 * Theme.dp;
                spacing: 8 * Theme.dp;
                VerticalLayout {
                    alignment: center;
                    Glyph {
                        source: @image-url("icons/paste.svg");
                        size: 22 * Theme.dp;
                        colorize: Theme.accent;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.paste-title;
                        color: Theme.text;
                        font-size: 15 * Theme.dp;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: root.paste-from;
                        font-family: "DejaVu Sans";
                        color: Theme.text-dim;
                        font-size: 12.5 * Theme.dp;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: "Cancel";
                        flat: true;
                        clicked => {
                            root.paste-cancel();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.paste-action;
                        primary: true;
                        enabled: root.view == "folder" && !root.read-only;
                        clicked => {
                            root.paste-go();
                        }
                    }
                }
            }
        }

        if root.view == "archive" && !root.selecting && root.form == "": ArchiveBar {
            count: root.archive-count;
            sub: root.archive-sub;
            extract-to => {
                root.extract-to();
            }
            extract-all => {
                root.extract-all();
            }
        }

        // F01: Browse · Recent · Types
        if root.footer: Footer {
            current: root.tab-index;
            tabs: [
                { icon: @image-url("@neoui/icons/sys/folder.svg"), label: "Browse" },
                { icon: @image-url("@neoui/icons/sys/recents.svg"), label: "Recent" },
                { icon: @image-url("@neoui/icons/sys/apps.svg"), label: "Types" },
            ];
            picked(i) => {
                root.tab(i);
            }
        }
    }

    // a name clash (files2-clash): Replace / Keep both / Skip, and whether the answer covers the rest
    viewer := ImageView {
        visible: root.view == "image";
        name: root.name;
        counter: root.img-counter;
        info: root.img-info;
        note: root.img-note;
        source: root.img;
        zoom: root.img-zoom;
        pan-x: root.img-pan-x;
        pan-y: root.img-pan-y;
        chrome: root.img-chrome;
        hint: root.img-hint;
        editable: root.img-editable;
        strip: root.img-strip;
        current: root.img-current;
        menu: root.img-menu;
        back => {
            root.up();
        }
        edit => {
            root.edit();
        }
        menu-picked(i) => {
            root.img-menu-picked(i);
        }
        strip-picked(i) => {
            root.img-strip-picked(i);
        }
        tapped => {
            root.img-tapped();
        }
        double-tapped(x, y) => {
            root.img-double-tapped(x, y);
        }
        dragged(x, y) => {
            root.img-dragged(x, y);
        }
        released(x, y) => {
            root.img-released(x, y);
        }
    }

    editor := ImageEdit {
        visible: root.view == "image-edit";
        name: root.name;
        source: root.img;
        can-undo: root.img-can-undo;
        can-redo: root.img-can-redo;
        cropping: root.img-cropping;
        crop-x: root.crop-x;
        crop-y: root.crop-y;
        crop-w: root.crop-w;
        crop-h: root.crop-h;
        size-label: root.crop-label;
        ratio: root.crop-ratio;
        note: root.img-save-note;
        saving: root.img-saving;
        resize-open <=> root.resize-open;
        resize-choices: root.resize-choices;
        resize-current: root.resize-current;
        back => {
            root.up();
        }
        undo => {
            root.undo();
        }
        redo => {
            root.img-redo();
        }
        menu-picked(i) => {
            root.img-edit-menu(i);
        }
        rotate => {
            root.img-rotate();
        }
        crop-mode => {
            root.img-crop-mode();
        }
        resize => {
            root.img-resize();
        }
        flip => {
            root.img-flip();
        }
        save => {
            root.img-save();
        }
        ratio-picked(i) => {
            root.crop-ratio-picked(i);
        }
        crop-start(h) => {
            root.crop-start(h);
        }
        crop-drag(h, x, y) => {
            root.crop-drag(h, x, y);
        }
        crop-done => {
            root.crop-done();
        }
        resize-chosen(i) => {
            root.resize-chosen(i);
        }
    }

    if root.clash-open: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        Rectangle {
            x: 16 * Theme.dp;
            width: parent.width - 32 * Theme.dp;
            height: clash-box.preferred-height;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius + 4 * Theme.dp;
            background: Theme.sheet;
            clash-box := VerticalLayout {
                padding: 20 * Theme.dp;
                spacing: 12 * Theme.dp;
                Text {
                    text: root.clash-title;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: 18 * Theme.dp;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Text {
                    text: root.clash-text;
                    color: Theme.text-secondary;
                    font-size: 14.5 * Theme.dp;
                    wrap: word-wrap;
                }

                if root.clash-count > 1: HorizontalLayout {
                    spacing: 12 * Theme.dp;
                    Rectangle {
                        width: 22 * Theme.dp;
                        height: self.width;
                        border-radius: 4 * Theme.dp;
                        background: root.clash-all ? Theme.accent : transparent;
                        border-width: root.clash-all ? 0 : 2 * Theme.dp;
                        border-color: Theme.text-dim;
                        if root.clash-all: Glyph {
                            source: @image-url("@neoui/icons/sys/check.svg");
                            size: 16 * Theme.dp;
                            colorize: white;
                        }
                    }

                    Text {
                        text: "Do this for all " + root.clash-count + " clashes";
                        color: Theme.text;
                        font-size: 15 * Theme.dp;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.clash-all = !root.clash-all;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    alignment: start;
                    Pill {
                        text: "Replace";
                        primary: true;
                        clicked => {
                            root.clash-answer(0);
                        }
                    }

                    Pill {
                        text: "Keep both";
                        clicked => {
                            root.clash-answer(1);
                        }
                    }

                    Pill {
                        text: "Skip";
                        clicked => {
                            root.clash-answer(2);
                        }
                    }
                }
            }
        }
    }

    // a form page over the folder: [✕ New folder ✓], [✕ New file ✓] or [✕ Rename ✓]; the keyboard comes up
    if root.form != "" && root.form != "compress": Rectangle {
        background: Theme.bg;
        TouchArea { }

        VerticalLayout {
            alignment: start;
            FormHeader {
                title: root.form == "folder" ? "New folder" : root.form == "file" ? "New file" : "Rename";
                can-save: root.name-text != "";
                cancel => {
                    root.form-cancel();
                }
                save => {
                    root.form-save();
                }
            }

            // where it goes (files2-new-folder): the tile and the folder
            if root.form != "rename": HorizontalLayout {
                padding: 16 * Theme.dp;
                spacing: 14 * Theme.dp;
                VerticalLayout {
                    alignment: center;
                    if root.form == "folder": FolderTile { }
                    if root.form == "file": FTile {
                        badge: "TXT";
                        colour: #8a93a0;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.form == "folder" ? "New folder in" : "New file in";
                        color: Theme.text-dim;
                        font-size: Theme.font-label;
                    }

                    Text {
                        text: root.form-dir;
                        font-family: "DejaVu Sans Mono";
                        color: Theme.text;
                        font-size: 15 * Theme.dp;
                        overflow: elide;
                    }
                }
            }
            VerticalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 16 * Theme.dp;
                padding-top: root.form == "rename" ? 16 * Theme.dp : 0;
                spacing: 8 * Theme.dp;
                SectionLabel {
                    text: "NAME";
                }

                HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    TextField {
                        horizontal-stretch: 1;
                        text <=> root.name-text;
                        placeholder: "Name";
                        autofocus: true;
                        accepted(t) => {
                            root.form-save();
                        }
                    }

                    if root.name-suffix != "": Text {
                        text: root.name-suffix;
                        font-family: "DejaVu Sans";
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.form == "rename" && root.name-suffix != "" ? "The extension stays " + root.name-suffix : "Up to 256 characters. Not allowed: \\ / : * ? \" < > |";
                    color: Theme.text-dim;
                    font-size: 12.5 * Theme.dp;
                    wrap: word-wrap;
                }
            }

            // files2-new-file: what kind of file
            if root.form == "file": VerticalLayout {
                padding: 16 * Theme.dp;
                spacing: 10 * Theme.dp;
                SectionLabel {
                    text: "TYPE";
                }

                TypeChips {
                    current: root.new-type;
                    picked(i) => {
                        root.new-type-picked(i);
                    }
                }

                Text {
                    text: "Code… asks for the extension (.rs, .py, .sh, .toml …) and opens the code editor.";
                    color: Theme.text-dim;
                    font-size: 12.5 * Theme.dp;
                    wrap: word-wrap;
                }
            }

            // what is renamed and where (files2-rename)
            if root.form == "rename": VerticalLayout {
                padding: 16 * Theme.dp;
                spacing: 8 * Theme.dp;
                SectionLabel {
                    text: "IN";
                }

                HorizontalLayout {
                    spacing: 14 * Theme.dp;
                    VerticalLayout {
                        alignment: center;
                        if root.form-badge == "": FolderTile { }
                        if root.form-badge != "": FTile {
                            badge: root.form-badge;
                            colour: root.form-colour;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3 * Theme.dp;
                        Text {
                            text: root.form-dir;
                            font-family: "DejaVu Sans";
                            color: Theme.text;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }

                        Text {
                            text: root.form-detail;
                            color: Theme.text-dim;
                            font-size: Theme.font-label;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    if root.form == "compress": CompressForm {
        title: root.compress-title;
        name <=> root.name-text;
        format: root.compress-format;
        dir: root.compress-dir;
        free: root.compress-free;
        total: root.compress-total;
        items: root.compress-items;
        note: root.compress-note;
        cancel => {
            root.form-cancel();
        }
        save => {
            root.form-save();
        }
        format-picked(i) => {
            root.compress-format-picked(i);
        }
        save-in => {
            root.save-in();
        }
    }

    if root.view == "pick-folder": FolderPicker {
        title: root.picker-title;
        drives: root.picker-drives;
        drive: root.picker-drive;
        crumbs: root.picker-crumbs;
        rows: root.picker-rows;
        action: root.picker-action;
        info: root.picker-info;
        can-pick: root.picker-can;
        cancel => {
            root.picker-cancel();
        }
        done => {
            root.picker-done();
        }
        drive-picked(i) => {
            root.picker-drive-picked(i);
        }
        crumb(i) => {
            root.picker-crumb(i);
        }
        open(i) => {
            root.picker-open(i);
        }
        new-folder => {
            root.picker-new-folder();
        }
    }

    // files2-extract: three ways, then the job's card while it runs
    Sheet {
        title: root.extract-title;
        open <=> root.extract-open;
        VerticalLayout {
            padding-left: 20 * Theme.dp;
            padding-right: 20 * Theme.dp;
            padding-bottom: 8 * Theme.dp;
            Text {
                text: root.extract-info;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                wrap: word-wrap;
            }
        }

        WayRow {
            icon: @image-url("icons/unarchive.svg");
            colour: #3d8bfd;
            title: "Extract here";
            sub: root.extract-here;
            chosen: true;
            clicked => {
                root.extract-way(0);
            }
        }

        WayRow {
            icon: @image-url("@neoui/icons/sys/folder.svg");
            colour: #e2a92a;
            title: "Extract to…";
            sub: "Pick a folder on any drive";
            clicked => {
                root.extract-way(1);
            }
        }

        if root.extract-browse: WayRow {
            icon: @image-url("@neoui/icons/sys/archive.svg");
            colour: #a0703c;
            title: "Browse inside";
            sub: "Read-only, nothing is unpacked";
            clicked => {
                root.extract-way(2);
            }
        }

        if root.extract-busy: VerticalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            padding-top: 8 * Theme.dp;
            JobCard {
                title: root.job-title;
                progress: root.job-progress;
                detail: root.job-detail;
                hide => {
                    root.extract-open = false;
                    root.job-hide();
                }
                cancel => {
                    root.job-cancel();
                }
            }
        }
    }

    // the Sort sheet (files2-sort): last in the window, full size
    Sheet {
        title: "Sort by";
        open <=> root.sort-open;
        for k[i] in ["Name", "Date modified", "Size", "Type"]: RadioRow {
            label: k;
            on: i == root.sort-key;
            picked => {
                root.sort-chosen(i);
            }
        }
        Rectangle {
            height: max(1px, Theme.dp / 2);
            background: #ffffff12;
        }

        SwitchRow {
            label: "Ascending";
            hint: "A → Z · oldest first · smallest first";
            on: root.ascending;
            toggled(v) => {
                root.ascending-changed(v);
            }
        }

        SwitchRow {
            label: "Folders first";
            hint: "Then files, in the same order";
            on: root.folders-first;
            toggled(v) => {
                root.folders-first-changed(v);
            }
        }
    }

    // files2-search-filters: Type, Size, Modified; Reset and Show N results
    Sheet {
        title: "Filters";
        open <=> root.filters-open;
        VerticalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            spacing: 8 * Theme.dp;
            SectionLabel {
                text: "TYPE";
            }

            for r in [[0, 1, 2, 3], [4, 5, 6], [7]]: HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                for i in r: Pick {
                    text: ["Any", "Images", "Audio", "Video", "Documents", "Archives", "Apps", "Code & text"][i];
                    on: i == root.f-type;
                    clicked => {
                        root.filter-type(i);
                    }
                }
            }
            SectionLabel {
                text: "SIZE";
            }

            for r in [[0, 1, 2], [3]]: HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                for i in r: Pick {
                    text: ["Any", "Under 1 MB", "1–100 MB", "Over 100 MB"][i];
                    on: i == root.f-size;
                    clicked => {
                        root.filter-size(i);
                    }
                }
            }
            SectionLabel {
                text: "MODIFIED";
            }

            for r in [[0, 1, 2], [3, 4]]: HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                for i in r: Pick {
                    text: ["Any time", "Today", "This week", "This month", "This year"][i];
                    on: i == root.f-modified;
                    clicked => {
                        root.filter-modified(i);
                    }
                }
            }
            HorizontalLayout {
                padding-top: 10 * Theme.dp;
                padding-bottom: 12 * Theme.dp;
                spacing: 10 * Theme.dp;
                Button {
                    horizontal-stretch: 1;
                    text: "Reset";
                    primary: false;
                    clicked => {
                        root.filters-reset();
                    }
                }

                Button {
                    horizontal-stretch: 1;
                    text: root.filter-results == 1 ? "Show 1 result" : "Show " + root.filter-results + " results";
                    clicked => {
                        root.filters-open = false;
                    }
                }
            }
        }
    }

    // files2-details: what it is, where, when; Read-only and Hidden can change, System can't
    Sheet {
        title: "Details";
        open <=> root.details-open;
        HorizontalLayout {
            padding-left: 20 * Theme.dp;
            padding-right: 20 * Theme.dp;
            padding-bottom: 12 * Theme.dp;
            spacing: 14 * Theme.dp;
            VerticalLayout {
                alignment: center;
                if root.details-item.folder: FolderTile {
                    size: 48 * Theme.dp;
                }
                if !root.details-item.folder: FTile {
                    size: 48 * Theme.dp;
                    badge: root.details-item.badge;
                    colour: root.details-item.colour;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2 * Theme.dp;
                horizontal-stretch: 1;
                Text {
                    text: root.details-item.name;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: 17 * Theme.dp;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: root.details-kind;
                    color: Theme.text-dim;
                    font-size: 13.5 * Theme.dp;
                }
            }
        }

        for d in root.details: DetailRow {
            d: d;
        }
        if root.details-attributes: VerticalLayout {
            padding-top: 10 * Theme.dp;
            SectionLabel {
                x: 20 * Theme.dp;
                text: "ATTRIBUTES";
            }

            SwitchRow {
                label: "Read-only";
                on: root.d-read-only;
                toggled(v) => {
                    root.details-read-only(v);
                }
            }

            SwitchRow {
                label: "Hidden";
                on: root.d-hidden;
                toggled(v) => {
                    root.details-hidden(v);
                }
            }

            SwitchRow {
                label: "System";
                hint: "Set by Symbian, not changeable";
                on: root.d-system;
                enabled: false;
            }
        }
    }
}
