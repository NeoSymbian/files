// SPDX-License-Identifier: GPL-3.0-only
// The Files app (NEOFILES.EXE), v2 (docs files-app.md FA1 + FA2, the canvas's files2-* boards) on the neoui kit:
// the Browse tab (drives), folders as a list or a grid with a breadcrumb, the folder and selection menus, the Sort
// sheet, the read-only banner, New folder / New file / Rename forms, the paste bar, a copy's progress toast and the
// name-clash dialog; FA3: Favourites and the Recent strip, the Recent and Types tabs, search with filters, the Recycle
// bin, Free up space and Details. The shell draws QUERY dialogs, toasts with Undo and the shade entry.
// The Rust side owns the state; this file draws it and reports taps as callbacks.
import "@neoui/fonts/NeoSans-Regular.ttf";
import "@neoui/fonts/NeoSans-Medium.ttf";
import "@neoui/fonts/NeoSans-SemiBold.ttf";
import "@neoui/fonts/NeoSans-Bold.ttf";
// Latin, Cyrillic and Armenian: names and text typed on the system keyboard, in any of its languages
import "@neoui/fonts/DejaVuSans.ttf";
import "@neoui/fonts/DejaVuSansMono.ttf";
import {
    Theme, Kit, KeyboardFocus, Scroll, Alphabets, Glyph, NeoList, Header, SubHeader, FormHeader, TextField, Act, Tab, Footer,
    Sheet, Switch, Button, ProgressBar
} from "@neoui/kit.slint";
import { FTile, FolderTile, DriveTile } from "tiles.slint";
import { TypeTile, Seg, CleanCard, Detail, Pick, UsedCard, GroupTile, CleanItem, InfoCard, DetailRow } from "fa3.slint";

export { Theme, Scroll, Kit, KeyboardFocus }

// kind: "phone", "mass", "card", "rom", "ram"
export struct DriveRow { title: string, size: string, detail: string, used: float, kind: string, read-only: bool }
// detail: "4.1 MB · 3 Nov" (list); short: "3.1 MB" or "812 items" (grid). state: 0 a file or folder, 1 being copied
// here (progress 0..1), 2 just copied. section: a heading above the row (Recent's "Today"); note: orange text at the
// end ("3 days left"); hit/post: a search match, drawn as name · hit (accent) · post
export struct FileRow {
    name: string,
    detail: string,
    short: string,
    folder: bool,
    badge: string,
    colour: color,
    checked: bool,
    state: int,
    progress: float,
    section: string,
    note: string,
    hit: string,
    post: string,
}

// a round check box (selection)
component Check inherits Rectangle {
    in property <bool> on;
    width: 24 * Theme.dp;
    height: self.width;
    border-radius: self.width / 2;
    background: root.on ? Theme.accent : transparent;
    border-width: root.on ? 0 : 2 * Theme.dp;
    border-color: Theme.text-dim;
    if root.on: Glyph {
        source: @image-url("@neoui/icons/sys/check.svg");
        size: 16 * Theme.dp;
        colorize: white;
    }
}

// A compact pill (the paste bar, the toast, the clash dialog: files2-paste-bar, files2-clash): 40 dp, 15 dp text;
// primary = accent fill, else a field fill, or `flat` (text only).
component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> flat;
    in property <bool> enabled: true;
    callback clicked();
    height: 40 * Theme.dp;
    width: label.preferred-width + (root.flat ? 24 : 32) * Theme.dp;
    border-radius: self.height / 2;
    opacity: root.enabled ? 1 : Theme.disabled;
    background: root.flat ? (touch.pressed ? Theme.pressed : transparent)
        : root.primary ? (touch.pressed ? Theme.accent.darker(20%) : Theme.accent)
        : (touch.pressed ? Theme.pressed : Theme.field);
    label := Text {
        text: root.text;
        color: root.flat && root.primary ? Theme.accent : root.flat ? Theme.text : white;
        font-size: 15 * Theme.dp;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// A tap, or a 500 ms hold (selection) without the tap after it (ListRow's rule).
component Press inherits TouchArea {
    callback tapped();
    callback held();
    property <bool> fired;
    changed pressed => {
        if self.pressed {
            self.fired = false;
        }
    }
    clicked => {
        if !self.fired {
            root.tapped();
        }
    }
    Timer {
        interval: 500ms;
        running: root.pressed && !root.fired;
        triggered => {
            root.fired = true;
            root.held();
        }
    }
}

// one row of a folder (files2-folder-list): 64 dp, a 40 dp tile, name and detail, a lock / chevron / state on the right
component FileItem inherits Rectangle {
    in property <FileRow> item;
    in property <bool> selecting;
    in property <bool> locked;
    callback tapped();
    callback held();
    height: 64 * Theme.dp;
    background: press.pressed ? Theme.pressed : root.item.checked ? #3d8bfd1f : transparent;
    press := Press {
        tapped => {
            root.tapped();
        }
        held => {
            root.held();
        }
    }

    HorizontalLayout {
        padding-left: 16 * Theme.dp;
        padding-right: 16 * Theme.dp;
        spacing: 14 * Theme.dp;
        if root.selecting: VerticalLayout {
            alignment: center;
            Check {
                on: root.item.checked;
            }
        }
        VerticalLayout {
            alignment: center;
            width: 40 * Theme.dp;
            opacity: root.item.state == 1 ? 0.5 : 1;
            HorizontalLayout {
                alignment: center;
                if root.item.folder: FolderTile { }
                if !root.item.folder: FTile {
                    badge: root.item.badge;
                    colour: root.item.colour;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 3 * Theme.dp;
            horizontal-stretch: 1;
            if root.item.hit == "": Text {
                text: root.item.name;
                font-family: "DejaVu Sans";
                color: Theme.text;
                font-size: Theme.font-body;
                font-weight: 500;
                overflow: elide;
            }
            if root.item.hit != "": HorizontalLayout {
                Text {
                    text: root.item.name;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                }

                Text {
                    text: root.item.hit;
                    font-family: "DejaVu Sans";
                    color: Theme.accent;
                    font-size: Theme.font-body;
                    font-weight: 500;
                }

                Text {
                    text: root.item.post;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 500;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }

            if root.item.note == "": Text {
                text: root.item.detail;
                color: Theme.text-dim;
                font-size: Theme.font-label;
                overflow: elide;
            }
            if root.item.note != "": HorizontalLayout {
                spacing: 4 * Theme.dp;
                Text {
                    text: root.item.detail + " ·";
                    font-family: "DejaVu Sans";
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                    overflow: elide;
                }

                Text {
                    text: root.item.note;
                    color: #f0a020;
                    font-size: Theme.font-label;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
            }
        }

        if root.item.state == 1: VerticalLayout {
            alignment: center;
            ProgressBar {
                width: 56 * Theme.dp;
                value: root.item.progress;
            }
        }
        if root.item.state == 2: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("@neoui/icons/sys/check.svg");
                size: 20 * Theme.dp;
                colorize: #22b46a;
            }
        }
        if root.locked && root.item.state == 0: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("@neoui/icons/sys/lock.svg");
                size: 16 * Theme.dp;
                colorize: Theme.text-dim;
            }
        }
        if root.item.folder && !root.selecting && !root.locked: VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                size: 18 * Theme.dp;
                colorize: Theme.text-dim;
            }
        }
    }

    Rectangle {
        x: 70 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: #ffffff12;
    }
}

// one cell of the 3-column grid (files2-folder-grid): a 60 dp folder or a 56 dp file tile, the name, the detail
component FileCell inherits Rectangle {
    in property <FileRow> item;
    in property <bool> selecting;
    callback tapped();
    callback held();
    border-radius: 12 * Theme.dp;
    background: press.pressed ? Theme.pressed : root.item.checked ? #3d8bfd1f : transparent;
    press := Press {
        tapped => {
            root.tapped();
        }
        held => {
            root.held();
        }
    }

    VerticalLayout {
        padding-top: 10 * Theme.dp;
        spacing: 4 * Theme.dp;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            height: 60 * Theme.dp;
            VerticalLayout {
                alignment: center;
                if root.item.folder: FolderTile {
                    size: 60 * Theme.dp;
                }
                if !root.item.folder: FTile {
                    size: 56 * Theme.dp;
                    badge: root.item.badge;
                    colour: root.item.colour;
                }
            }
        }

        Text {
            text: root.item.name;
            font-family: "DejaVu Sans";
            color: Theme.text;
            font-size: 13.5 * Theme.dp;
            font-weight: 500;
            horizontal-alignment: center;
            overflow: elide;
        }

        Text {
            text: root.item.short;
            color: Theme.text-dim;
            font-size: 12 * Theme.dp;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    if root.selecting: Check {
        x: 8 * Theme.dp;
        y: 8 * Theme.dp;
        on: root.item.checked;
    }
}

// the drives card (files2-browse): a tile, "C: Phone memory" and its size, the usage line and bar
component DriveItem inherits Rectangle {
    in property <DriveRow> drive;
    in property <bool> last;
    callback tapped();
    height: (root.drive.read-only ? 76 : 86) * Theme.dp;
    background: touch.pressed ? Theme.pressed : transparent;
    touch := TouchArea {
        clicked => {
            root.tapped();
        }
    }

    HorizontalLayout {
        padding-left: 14 * Theme.dp;
        padding-right: 14 * Theme.dp;
        spacing: 14 * Theme.dp;
        VerticalLayout {
            alignment: center;
            DriveTile {
                kind: root.drive.kind;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 4 * Theme.dp;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                Text {
                    text: root.drive.title;
                    color: Theme.text;
                    font-size: Theme.font-body;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.drive.read-only: VerticalLayout {
                    alignment: center;
                    Glyph {
                        source: @image-url("@neoui/icons/sys/lock.svg");
                        size: 14 * Theme.dp;
                        colorize: Theme.text-dim;
                    }
                }
                Text {
                    text: root.drive.size;
                    color: Theme.text-dim;
                    font-size: Theme.font-label;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.drive.detail;
                color: Theme.text-secondary;
                font-size: Theme.font-label;
                overflow: elide;
            }

            if !root.drive.read-only: Rectangle {
                height: 6 * Theme.dp;
                border-radius: self.height / 2;
                background: #ffffff1a;
                Rectangle {
                    x: 0;
                    width: parent.width * root.drive.used;
                    border-radius: parent.border-radius;
                    background: root.drive.kind == "mass" ? #7b6cf0 : root.drive.kind == "card" ? #22b46a : Theme.accent;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Glyph {
                source: @image-url("@neoui/icons/sys/chevron_right.svg");
                size: 18 * Theme.dp;
                colorize: Theme.text-dim;
            }
        }
    }

    if !root.last: Rectangle {
        x: 68 * Theme.dp;
        y: parent.height - self.height;
        width: parent.width - self.x;
        height: max(1px, Theme.dp / 2);
        background: #ffffff12;
    }
}

component SectionLabel inherits Text {
    color: Theme.text-dim;
    font-size: 12.5 * Theme.dp;
    font-weight: 600;
    letter-spacing: 0.8px;
}

// a section's label with a link at the end (files2-browse: FAVOURITES · Edit, RECENT · See all)
component HeadingLink inherits HorizontalLayout {
    in property <string> text;
    in property <string> link;
    callback clicked();
    height: 30 * Theme.dp;
    padding-left: 4 * Theme.dp;
    padding-top: 8 * Theme.dp;
    SectionLabel {
        text: root.text;
        horizontal-stretch: 1;
        vertical-alignment: center;
    }

    Text {
        text: root.link;
        color: Theme.accent;
        font-size: 14 * Theme.dp;
        font-weight: 600;
        vertical-alignment: center;
        TouchArea {
            clicked => {
                root.clicked();
            }
        }
    }
}

// one choice in the Sort sheet: a radio and its label
component RadioRow inherits Rectangle {
    in property <string> label;
    in property <bool> on;
    callback picked();
    height: 56 * Theme.dp;
    background: touch.pressed ? Theme.pressed : transparent;
    touch := TouchArea {
        clicked => {
            root.picked();
        }
    }

    HorizontalLayout {
        padding-left: 20 * Theme.dp;
        spacing: 16 * Theme.dp;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 22 * Theme.dp;
                height: self.width;
                border-radius: self.width / 2;
                border-width: 2 * Theme.dp;
                border-color: root.on ? Theme.accent : Theme.text-dim;
                if root.on: Rectangle {
                    width: 10 * Theme.dp;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: Theme.accent;
                }
            }
        }

        Text {
            text: root.label;
            color: Theme.text;
            font-size: Theme.font-body;
            vertical-alignment: center;
        }
    }
}

component SwitchRow inherits Rectangle {
    in property <string> label;
    in property <string> hint;
    in property <bool> on;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: 56 * Theme.dp;
    HorizontalLayout {
        padding-left: 20 * Theme.dp;
        padding-right: 20 * Theme.dp;
        spacing: 12 * Theme.dp;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 2 * Theme.dp;
            Text {
                text: root.label;
                color: Theme.text;
                font-size: Theme.font-body;
            }

            Text {
                text: root.hint;
                color: Theme.text-dim;
                font-size: 12.5 * Theme.dp;
            }
        }

        VerticalLayout {
            alignment: center;
            Switch {
                on: root.on;
                opacity: root.enabled ? 1 : 0.4;
                toggled(v) => {
                    root.toggled(v);
                }
                // System: shown, not changeable
                if !root.enabled: TouchArea { }
            }
        }
    }
}

export component FilesApp inherits Window {
    default-font-family: "NeoSans";
    background: Theme.bg;

    // "browse" (the drives), "folder" or "text"
    in property <string> view: "browse";
    in property <[DriveRow]> drives;
    // the open folder or file: its name (the header's title) and the breadcrumb's labels
    in property <string> name;
    in property <[string]> crumbs;
    in property <[FileRow]> rows;
    in property <bool> grid;
    in property <bool> read-only;
    in property <bool> show-hidden;
    in property <string> text;
    // rows picked (selection mode, K03): how many
    in property <int> selected;
    // the Sort sheet
    in-out property <bool> sort-open;
    in property <int> sort-key;
    in property <bool> ascending: true;
    in property <bool> folders-first: true;
    // the paste bar (F06): "2 files to move", "from E:\Music", "Move here"; hidden while the action is ""
    in property <string> paste-title;
    in property <string> paste-from;
    in property <string> paste-action;
    // a copy or move running: the toast's text and progress (0..1); hidden while the text is ""
    in property <string> job-text;
    in property <float> job-progress;
    // a name clash: the question, the two versions, how many clashes this answer can cover
    in property <bool> clash-open;
    in property <string> clash-title;
    in property <string> clash-text;
    in property <int> clash-count;
    in-out property <bool> clash-all: true;
    // "" (none), "folder", "file" or "rename": a form page over the folder
    in property <string> form;
    in property <string> form-dir;
    in-out property <string> name-text;
    // Rename keeps the extension (files2-rename): ".flac", and what the file is
    in property <string> name-suffix;
    in property <string> form-detail;
    in property <string> form-badge;
    in property <color> form-colour;
    in property <bool> refreshing;
    // the system keyboard's height over the bottom of the surface, while a name is typed
    in property <length> kb-h;

    // FA3. tab: the footer's (0 Browse, 1 Recent, 2 Types); views "recent", "types", "type", "bin", "cleanup",
    // "review", "favs" besides "browse", "folder" and "text"
    in property <int> tab-index;
    in property <[FileRow]> favs;
    in property <[FileRow]> recent-strip;
    // the open selection holds exactly one item / one folder (the ⋮ offers Details / Add to Favourites)
    in property <bool> one-item;
    in property <bool> one-folder;
    // a list with nothing picked yet (the bin's ⋮ Select)
    in-out property <bool> picking;
    in property <string> empty-text;
    // files2-types and the type page (files2-type-docs)
    in property <string> types-used;
    in property <string> types-of;
    in property <[Seg]> types-bar;
    in property <[TypeTile]> types;
    in property <[string]> type-drives;
    in property <int> type-drive;
    in property <[string]> type-subs;
    in property <int> type-sub;
    in property <string> updating;
    // search (files2-search): the header's query, the scope chips, the filters sheet
    in-out property <bool> searching;
    in-out property <string> query;
    in property <[FileRow]> hits;
    in property <string> search-info;
    in property <bool> search-folder;
    in property <bool> can-search-folder;
    in property <int> filter-count;
    in-out property <bool> filters-open;
    in property <int> f-type;
    in property <int> f-size;
    in property <int> f-modified;
    in property <int> filter-results;
    // the bin (files2-bin) and Free up space (files2-cleanup)
    in property <string> info-title;
    in property <string> info-text;
    in property <string> can-free;
    in property <[CleanCard]> clean;
    // Details (files2-details)
    in-out property <bool> details-open;
    in property <FileRow> details-item;
    in property <string> details-kind;
    in property <[Detail]> details;
    in property <bool> details-attributes;
    in property <bool> d-read-only;
    in property <bool> d-hidden;
    in property <bool> d-system;

    callback drive(int);
    callback open-row(int);
    callback toggle(int);
    callback crumb(int);
    callback up();
    callback tab(int);
    callback menu(string);
    callback selection-action(int);
    callback selection-menu(string);
    callback clear-selection();
    callback new-folder();
    callback new-file();
    callback refresh();
    callback sort-chosen(int);
    callback ascending-changed(bool);
    callback folders-first-changed(bool);
    callback paste-cancel();
    callback paste-go();
    callback job-hide();
    callback clash-answer(int);
    callback form-cancel();
    callback form-save();
    callback fav(int);
    callback fav-remove(int);
    callback favs-edit();
    callback recent-open(int);
    callback see-all();
    callback type-open(int);
    callback type-drive-picked(int);
    callback type-sub-picked(int);
    callback searched(string);
    callback search-scope(bool);
    callback hit-open(int);
    callback filter-type(int);
    callback filter-size(int);
    callback filter-modified(int);
    callback filters-reset();
    callback review(int);
    callback details-read-only(bool);
    callback details-hidden(bool);

    property <[string]> root-menu: ["Recycle bin", "Free up space", root.show-hidden ? "Hide hidden files" : "Show hidden files"];
    property <[string]> folder-menu: root.read-only ? [
        "Sort by", root.grid ? "List view" : "Grid view", root.show-hidden ? "Hide hidden" : "Show hidden", "Details"
    ] : [
        "New folder", "New file", "Sort by", root.grid ? "List view" : "Grid view",
        root.show-hidden ? "Hide hidden" : "Show hidden", "Details"
    ];
    property <[string]> pick-menu: root.read-only ? (root.one-item ? ["Details", "Select all"] : ["Select all"])
        : root.one-folder ? ["Move", "Rename", "Add to Favourites", "Details", "Select all"]
        : root.one-item ? ["Move", "Rename", "Details", "Select all"] : ["Move", "Rename", "Select all"];
    property <[string]> bin-menu: ["Empty bin", "Select"];
    property <bool> selecting: root.selected > 0 || root.picking;
    property <bool> tab-root: root.view == "browse" || root.view == "recent" || root.view == "types";
    property <bool> footer: root.form == "" && !root.selecting && !root.searching
        && (root.tab-root || root.view == "folder");
    property <bool> listing: root.view == "recent" || root.view == "type" || root.view == "bin" || root.view == "review";

    Alphabets { }

    VerticalLayout {
        if root.tab-root: Header {
            title: "Files";
            searching <=> root.searching;
            query <=> root.query;
            searched(t) => {
                root.searched(t);
            }
            menu: root.root-menu;
            menu-picked(i) => {
                root.menu(root.root-menu[i]);
            }
            top => {
                browse-list.to-top();
                list-view.to-top();
            }
        }
        if root.view == "folder": SubHeader {
            title: root.name;
            title-font: "DejaVu Sans";
            searching <=> root.searching;
            query <=> root.query;
            searched(t) => {
                root.searched(t);
            }
            menu: root.folder-menu;
            selected: root.selected;
            selection-actions: [
                { icon: @image-url("icons/copy.svg"), label: "Copy" },
                { icon: @image-url("@neoui/icons/sys/delete.svg"), label: "Delete", disabled: root.read-only },
            ];
            selection-menu: root.pick-menu;
            back => {
                root.up();
            }
            menu-picked(i) => {
                root.menu(root.folder-menu[i]);
            }
            selection-action(i) => {
                root.selection-action(i);
            }
            selection-menu-picked(i) => {
                root.selection-menu(root.pick-menu[i]);
            }
            selection-closed => {
                root.clear-selection();
            }
            top => {
                folder-list.to-top();
            }
        }
        if root.view == "text": SubHeader {
            title: root.name;
            title-font: "DejaVu Sans";
            search: false;
            back => {
                root.up();
            }
        }
        if root.view == "type": SubHeader {
            title: root.name;
            searching <=> root.searching;
            query <=> root.query;
            searched(t) => {
                root.searched(t);
            }
            back => {
                root.up();
            }
            top => {
                list-view.to-top();
            }
        }
        // the bin and the Free up space reviews pick rows; Restore / Delete forever, or Delete (to the bin)
        if root.view == "bin" || root.view == "review": SubHeader {
            title: root.name;
            search: false;
            menu: root.view == "bin" ? root.bin-menu : ["Select all"];
            selected: root.selected;
            selecting: root.picking;
            selection-actions: root.view == "bin" ? [
                { icon: @image-url("@neoui/icons/sys/recents.svg"), label: "Restore" },
                { icon: @image-url("@neoui/icons/sys/delete.svg"), label: "Delete forever" },
            ] : [
                { icon: @image-url("@neoui/icons/sys/delete.svg"), label: "Delete" },
            ];
            selection-menu: ["Select all"];
            back => {
                root.up();
            }
            menu-picked(i) => {
                root.menu(root.view == "bin" ? root.bin-menu[i] : "Select all");
            }
            selection-action(i) => {
                root.selection-action(i);
            }
            selection-menu-picked(i) => {
                root.selection-menu("Select all");
            }
            selection-closed => {
                root.clear-selection();
            }
            top => {
                list-view.to-top();
            }
        }
        if root.view == "cleanup" || root.view == "favs": SubHeader {
            title: root.view == "cleanup" ? "Free up space" : "Favourites";
            search: false;
            back => {
                root.up();
            }
        }

        // the breadcrumb (F05): the drive, then each folder; the last is where you are
        if root.view == "folder" || root.view == "text": HorizontalLayout {
            height: 40 * Theme.dp;
            padding-left: 12 * Theme.dp;
            padding-right: 12 * Theme.dp;
            spacing: 4 * Theme.dp;
            alignment: start;
            for c[i] in root.crumbs: HorizontalLayout {
                spacing: 4 * Theme.dp;
                if i > 0: VerticalLayout {
                    alignment: center;
                    Glyph {
                        source: @image-url("@neoui/icons/sys/chevron_right.svg");
                        size: 14 * Theme.dp;
                        colorize: Theme.text-dim;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        property <bool> here: i == root.crumbs.length - 1;
                        height: 28 * Theme.dp;
                        width: crumb-text.preferred-width + 20 * Theme.dp;
                        border-radius: self.height / 2;
                        background: crumb-touch.pressed ? Theme.pressed : self.here ? Theme.tab-pill : Theme.field;
                        crumb-text := Text {
                            text: c;
                            font-family: "DejaVu Sans";
                            color: parent.here ? Theme.text : Theme.text-secondary;
                            font-size: 13.5 * Theme.dp;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        crumb-touch := TouchArea {
                            clicked => {
                                root.crumb(i);
                            }
                        }
                    }
                }
            }
        }

        // Z: and other read-only drives (files2-rom)
        if root.view == "folder" && root.read-only && !root.selecting: Rectangle {
            height: banner.preferred-height + 12 * Theme.dp;
            Rectangle {
                x: 12 * Theme.dp;
                y: 4 * Theme.dp;
                width: parent.width - 24 * Theme.dp;
                height: banner.preferred-height;
                border-radius: Theme.radius;
                background: Theme.card;
                border-width: max(1px, Theme.dp / 2);
                border-color: #ffffff14;
                banner := HorizontalLayout {
                    padding: 14 * Theme.dp;
                    spacing: 12 * Theme.dp;
                    VerticalLayout {
                        alignment: start;
                        Glyph {
                            source: @image-url("@neoui/icons/sys/lock.svg");
                            size: 20 * Theme.dp;
                            colorize: #e2a92a;
                        }
                    }
                    VerticalLayout {
                        spacing: 3 * Theme.dp;
                        Text {
                            text: "Read-only drive";
                            color: Theme.text;
                            font-size: Theme.font-body;
                            font-weight: 600;
                        }

                        Text {
                            text: "You can open and copy these files, not change or delete them.";
                            color: Theme.text-secondary;
                            font-size: Theme.font-label;
                            wrap: word-wrap;
                        }
                    }
                }
            }
        }

        // the views share the rest of the surface; the hidden ones stay (their ids are used above)
        Rectangle {
            vertical-stretch: 1;
            browse-list := NeoList {
                visible: root.view == "browse" && !root.searching;
                VerticalLayout {
                    alignment: start;
                    padding-left: 12 * Theme.dp;
                    padding-right: 12 * Theme.dp;
                    padding-top: 6 * Theme.dp;
                    spacing: 8 * Theme.dp;
                    SectionLabel {
                        x: 4 * Theme.dp;
                        text: "DRIVES";
                    }

                    Rectangle {
                        border-radius: Theme.radius;
                        background: Theme.card;
                        border-width: max(1px, Theme.dp / 2);
                        border-color: #ffffff14;
                        clip: true;
                        VerticalLayout {
                            for d[i] in root.drives: DriveItem {
                                drive: d;
                                last: i == root.drives.length - 1;
                                tapped => {
                                    root.drive(i);
                                }
                            }
                        }
                    }

                    // files2-browse: Favourites (up to 3 shown) and the last 4 files opened
                    if root.favs.length > 0: HeadingLink {
                        text: "FAVOURITES";
                        link: "Edit";
                        clicked => {
                            root.favs-edit();
                        }
                    }
                    if root.favs.length > 0: HorizontalLayout {
                        spacing: 8 * Theme.dp;
                        for f[i] in root.favs: Rectangle {
                            horizontal-stretch: 1;
                            preferred-width: 0;
                            min-width: 0;
                            height: 82 * Theme.dp;
                            border-radius: Theme.radius;
                            background: fav-touch.pressed ? Theme.pressed : Theme.card;
                            border-width: max(1px, Theme.dp / 2);
                            border-color: #ffffff14;
                            fav-touch := TouchArea {
                                clicked => {
                                    root.fav(i);
                                }
                            }
                            VerticalLayout {
                                padding: 12 * Theme.dp;
                                spacing: 2 * Theme.dp;
                                HorizontalLayout {
                                    alignment: start;
                                    FolderTile {
                                        size: 30 * Theme.dp;
                                    }
                                }

                                Text {
                                    text: f.name;
                                    font-family: "DejaVu Sans";
                                    color: Theme.text;
                                    font-size: 14.5 * Theme.dp;
                                    font-weight: 600;
                                    overflow: elide;
                                }

                                Text {
                                    text: f.detail;
                                    color: Theme.text-dim;
                                    font-size: 12 * Theme.dp;
                                }
                            }
                        }
                    }
                    if root.recent-strip.length > 0: HeadingLink {
                        text: "RECENT";
                        link: "See all";
                        clicked => {
                            root.see-all();
                        }
                    }
                    if root.recent-strip.length > 0: HorizontalLayout {
                        spacing: 8 * Theme.dp;
                        for r[i] in root.recent-strip: VerticalLayout {
                            horizontal-stretch: 1;
                            preferred-width: 0;
                            min-width: 0;
                            spacing: 6 * Theme.dp;
                            Rectangle {
                                height: 64 * Theme.dp;
                                border-radius: Theme.radius;
                                background: strip-touch.pressed ? Theme.pressed : Theme.card;
                                border-width: max(1px, Theme.dp / 2);
                                border-color: #ffffff14;
                                strip-touch := TouchArea {
                                    clicked => {
                                        root.recent-open(i);
                                    }
                                }
                                FTile {
                                    badge: r.badge;
                                    colour: r.colour;
                                }
                            }

                            Text {
                                text: r.name;
                                font-family: "DejaVu Sans";
                                color: Theme.text;
                                font-size: 12.5 * Theme.dp;
                                font-weight: 500;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }

            // Recent, a type's files, the bin and a Free up space review: rows with headings
            list-view := NeoList {
                visible: root.listing && !root.searching;
                selected: root.selected;
                VerticalLayout {
                    alignment: start;
                    if root.view == "type": HorizontalLayout {
                        padding: 12 * Theme.dp;
                        visible: root.type-subs.length == 0;
                        height: root.type-subs.length == 0 ? self.preferred-height : 0;
                        spacing: 8 * Theme.dp;
                        alignment: start;
                        for t[i] in root.type-drives: Pick {
                            text: t;
                            on: i == root.type-drive;
                            check: i == 0;
                            clicked => {
                                root.type-drive-picked(i);
                            }
                        }
                    }
                    if root.view == "type" && root.type-subs.length > 0: HorizontalLayout {
                        padding: 12 * Theme.dp;
                        spacing: 8 * Theme.dp;
                        alignment: start;
                        for t[i] in root.type-subs: Pick {
                            text: t;
                            on: i == root.type-sub;
                            check: i == 0;
                            clicked => {
                                root.type-sub-picked(i);
                            }
                        }
                    }
                    if root.info-title != "" && (root.view == "bin" || root.view == "review"): VerticalLayout {
                        padding: 12 * Theme.dp;
                        InfoCard {
                            title: root.info-title;
                            text: root.info-text;
                        }
                    }
                    if root.rows.length == 0 && root.empty-text != "": Text {
                        height: 160 * Theme.dp;
                        text: root.empty-text;
                        color: Theme.text-dim;
                        font-size: 15 * Theme.dp;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    for f[i] in root.rows: VerticalLayout {
                        if f.section != "": SectionLabel {
                            height: 36 * Theme.dp;
                            x: 16 * Theme.dp;
                            text: f.section;
                            vertical-alignment: center;
                        }
                        FileItem {
                            item: f;
                            selecting: root.selecting && (root.view == "bin" || root.view == "review");
                            held => {
                                if root.view == "bin" || root.view == "review" {
                                    root.toggle(i);
                                }
                            }
                            tapped => {
                                if root.selecting && (root.view == "bin" || root.view == "review") {
                                    root.toggle(i);
                                } else {
                                    root.open-row(i);
                                }
                            }
                        }
                    }
                    if root.updating != "": Text {
                        height: 40 * Theme.dp;
                        text: root.updating;
                        color: Theme.text-dim;
                        font-size: 13 * Theme.dp;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // files2-types: the used card and the 2 x 4 tiles
            NeoList {
                visible: root.view == "types" && !root.searching;
                VerticalLayout {
                    alignment: start;
                    padding: 12 * Theme.dp;
                    spacing: 8 * Theme.dp;
                    UsedCard {
                        used: root.types-used;
                        of: root.types-of;
                        segs: root.types-bar;
                    }

                    for r in 4: HorizontalLayout {
                        spacing: 8 * Theme.dp;
                        if r * 2 < root.types.length: GroupTile {
                            tile: root.types[r * 2];
                            tapped => {
                                root.type-open(r * 2);
                            }
                        }
                        if r * 2 + 1 < root.types.length: GroupTile {
                            tile: root.types[r * 2 + 1];
                            tapped => {
                                root.type-open(r * 2 + 1);
                            }
                        }
                    }
                    if root.updating != "": Text {
                        text: root.updating;
                        color: Theme.text-dim;
                        font-size: 13 * Theme.dp;
                        horizontal-alignment: center;
                    }
                }
            }

            // files2-cleanup: the drives, what can be freed, four reviews
            NeoList {
                visible: root.view == "cleanup";
                VerticalLayout {
                    alignment: start;
                    padding: 12 * Theme.dp;
                    spacing: 10 * Theme.dp;
                    Rectangle {
                        border-radius: Theme.radius;
                        background: Theme.card;
                        border-width: max(1px, Theme.dp / 2);
                        border-color: #ffffff14;
                        clip: true;
                        // files2-cleanup: title · "12.4 GB of 41.8 GB", the bar, then what is free (size and detail)
                        VerticalLayout {
                            for d[i] in root.drives: VerticalLayout {
                                padding: 16 * Theme.dp;
                                spacing: 8 * Theme.dp;
                                HorizontalLayout {
                                    Text {
                                        text: d.title;
                                        color: Theme.text;
                                        font-size: 15 * Theme.dp;
                                        font-weight: 600;
                                        horizontal-stretch: 1;
                                    }

                                    Text {
                                        text: d.size;
                                        color: Theme.text-secondary;
                                        font-size: 13.5 * Theme.dp;
                                    }
                                }

                                Rectangle {
                                    height: 6 * Theme.dp;
                                    border-radius: self.height / 2;
                                    background: #ffffff1a;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * d.used;
                                        border-radius: parent.border-radius;
                                        background: d.kind == "phone" ? #3d8bfd : #22b46a;
                                    }
                                }

                                Text {
                                    text: d.detail;
                                    color: Theme.text-dim;
                                    font-size: 13 * Theme.dp;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-top: 6 * Theme.dp;
                        padding-left: 4 * Theme.dp;
                        spacing: 8 * Theme.dp;
                        alignment: start;
                        Text {
                            text: root.can-free;
                            color: Theme.text;
                            font-size: 22 * Theme.dp;
                            font-weight: 700;
                        }

                        Text {
                            text: root.updating != "" ? root.updating : "can be freed";
                            color: Theme.text-secondary;
                            font-size: 14 * Theme.dp;
                            vertical-alignment: bottom;
                        }
                    }

                    for c[i] in root.clean: CleanItem {
                        card: c;
                        review => {
                            root.review(i);
                        }
                    }
                }
            }

            // Favourites › Edit: ✕ takes one off
            NeoList {
                visible: root.view == "favs";
                VerticalLayout {
                    alignment: start;
                    if root.favs.length == 0: Text {
                        height: 160 * Theme.dp;
                        text: "No favourites. Long-press a folder, then ⋮ › Add to Favourites.";
                        color: Theme.text-dim;
                        font-size: 15 * Theme.dp;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: word-wrap;
                    }
                    for f[i] in root.favs: HorizontalLayout {
                        height: 64 * Theme.dp;
                        padding-left: 16 * Theme.dp;
                        padding-right: 8 * Theme.dp;
                        spacing: 14 * Theme.dp;
                        VerticalLayout {
                            alignment: center;
                            FolderTile { }
                        }
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: f.name;
                                font-family: "DejaVu Sans";
                                color: Theme.text;
                                font-size: Theme.font-body;
                                font-weight: 500;
                                overflow: elide;
                            }

                            Text {
                                text: f.detail;
                                font-family: "DejaVu Sans";
                                color: Theme.text-dim;
                                font-size: Theme.font-label;
                                overflow: elide;
                            }
                        }

                        Rectangle {
                            width: 48 * Theme.dp;
                            background: x-touch.pressed ? Theme.pressed : transparent;
                            border-radius: self.width / 2;
                            x-touch := TouchArea {
                                clicked => {
                                    root.fav-remove(i);
                                }
                            }
                            Glyph {
                                source: @image-url("@neoui/icons/sys/close.svg");
                                size: 20 * Theme.dp;
                                colorize: Theme.text-secondary;
                            }
                        }
                    }
                }
            }

            // files2-search: scope chips and Filters, the count, the hits (a tap opens; a folder opens there)
            NeoList {
                visible: root.searching;
                VerticalLayout {
                    alignment: start;
                    HorizontalLayout {
                        padding: 12 * Theme.dp;
                        spacing: 8 * Theme.dp;
                        Pick {
                            text: "All drives";
                            on: !root.search-folder;
                            clicked => {
                                root.search-scope(false);
                            }
                        }

                        if root.can-search-folder: Pick {
                            text: "This folder";
                            on: root.search-folder;
                            clicked => {
                                root.search-scope(true);
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                        }

                        Pick {
                            text: "Filters";
                            check: false;
                            has-icon: true;
                            icon: @image-url("@neoui/icons/sys/filter.svg");
                            count: root.filter-count;
                            clicked => {
                                root.filters-open = true;
                            }
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16 * Theme.dp;
                        padding-right: 16 * Theme.dp;
                        height: 28 * Theme.dp;
                        Text {
                            text: root.search-info;
                            color: Theme.text-dim;
                            font-size: 13 * Theme.dp;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }

                    for f[i] in root.hits: FileItem {
                        item: f;
                        tapped => {
                            root.hit-open(i);
                        }
                    }
                }
            }

            // files come from outside (K03): pull to list the folder again
            folder-list := NeoList {
                visible: root.view == "folder" && !root.searching;
                pull-refresh: true;
                refreshing: root.refreshing;
                selected: root.selected;
                refresh => {
                    root.refresh();
                }
                VerticalLayout {
                    alignment: start;
                    // files2-folder-empty
                    if root.rows.length == 0: VerticalLayout {
                        padding-top: 72 * Theme.dp;
                        padding-left: 32 * Theme.dp;
                        padding-right: 32 * Theme.dp;
                        spacing: 14 * Theme.dp;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 120 * Theme.dp;
                                height: self.width;
                                border-radius: self.width / 2;
                                background: Theme.card;
                                FolderTile {
                                    size: 64 * Theme.dp;
                                }
                            }
                        }

                        Text {
                            text: "This folder is empty";
                            color: Theme.text;
                            font-size: 18 * Theme.dp;
                            font-weight: 600;
                            horizontal-alignment: center;
                        }

                        Text {
                            text: root.read-only ? "" : "Make a folder or a file here, or paste files you copied from another folder.";
                            color: Theme.text-secondary;
                            font-size: 14 * Theme.dp;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        if !root.read-only: HorizontalLayout {
                            alignment: center;
                            spacing: 10 * Theme.dp;
                            Button {
                                text: "New folder";
                                icon: @image-url("@neoui/icons/sys/add.svg");
                                has-icon: true;
                                clicked => {
                                    root.new-folder();
                                }
                            }

                            Button {
                                text: "New file";
                                primary: false;
                                clicked => {
                                    root.new-file();
                                }
                            }
                        }
                    }
                    if !root.grid: VerticalLayout {
                        for f[i] in root.rows: FileItem {
                            item: f;
                            selecting: root.selecting;
                            locked: root.read-only;
                            held => {
                                root.toggle(i);
                            }
                            tapped => {
                                if root.selecting {
                                    root.toggle(i);
                                } else {
                                    root.open-row(i);
                                }
                            }
                        }
                    }
                    if root.grid: Rectangle {
                        property <length> cell-w: (self.width - 16 * Theme.dp) / 3;
                        property <length> cell-h: 124 * Theme.dp;
                        height: Math.ceil(root.rows.length / 3) * self.cell-h + 8 * Theme.dp;
                        for f[i] in root.rows: FileCell {
                            x: 8 * Theme.dp + Math.mod(i, 3) * parent.cell-w;
                            y: Math.floor(i / 3) * parent.cell-h;
                            width: parent.cell-w;
                            height: parent.cell-h;
                            item: f;
                            selecting: root.selecting;
                            held => {
                                root.toggle(i);
                            }
                            tapped => {
                                if root.selecting {
                                    root.toggle(i);
                                } else {
                                    root.open-row(i);
                                }
                            }
                        }
                    }
                    // files2-paste-bar: where to go next
                    if root.paste-action != "" && root.rows.length > 0 && root.rows.length < 6: VerticalLayout {
                        padding-top: 120 * Theme.dp;
                        padding-left: 40 * Theme.dp;
                        padding-right: 40 * Theme.dp;
                        spacing: 10 * Theme.dp;
                        HorizontalLayout {
                            alignment: center;
                            Glyph {
                                source: @image-url("icons/move.svg");
                                size: 28 * Theme.dp;
                                colorize: Theme.text-dim;
                            }
                        }

                        Text {
                            text: "Open the folder you want, then tap " + root.paste-action + ". Tabs and drives still work.";
                            color: Theme.text-dim;
                            font-size: 13.5 * Theme.dp;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }
                    // room for the toast and the paste bar over the last rows
                    Rectangle {
                        height: (root.job-text != "" ? 72 : 0) * Theme.dp;
                    }
                }
            }

            NeoList {
                visible: root.view == "text";
                VerticalLayout {
                    alignment: start;
                    padding: Theme.margin;
                    Text {
                        text: root.text;
                        wrap: char-wrap;
                        font-family: "DejaVu Sans Mono";
                        font-size: 13.5 * Theme.dp;
                        color: #d7dde5;
                    }
                }
            }

            // a copy or move (files2-progress): over the bottom of the list, Hide moves it to the shade only
            if root.job-text != "": Rectangle {
                x: 12 * Theme.dp;
                y: parent.height - self.height - 12 * Theme.dp;
                width: parent.width - 24 * Theme.dp;
                height: 56 * Theme.dp;
                border-radius: Theme.radius;
                background: #2a2e35;
                clip: true;
                HorizontalLayout {
                    padding-left: 16 * Theme.dp;
                    padding-right: 8 * Theme.dp;
                    spacing: 12 * Theme.dp;
                    VerticalLayout {
                        alignment: center;
                        Glyph {
                            source: @image-url("icons/copy.svg");
                            size: 20 * Theme.dp;
                            colorize: Theme.text-secondary;
                        }
                    }
                    Text {
                        text: root.job-text;
                        color: Theme.text;
                        font-size: 14.5 * Theme.dp;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: "Hide";
                            flat: true;
                            primary: true;
                            clicked => {
                                root.job-hide();
                            }
                        }
                    }
                }

                Rectangle {
                    x: 0;
                    y: parent.height - self.height;
                    height: 3 * Theme.dp;
                    width: parent.width * max(0, min(1, root.job-progress));
                    background: Theme.accent;
                }
            }
        }

        // the paste bar (F06): above the footer, so tabs and drives still work while it waits
        if root.paste-action != "" && root.form == "": Rectangle {
            height: 60 * Theme.dp;
            background: Theme.card;
            Rectangle {
                y: 0;
                height: max(1px, Theme.dp / 2);
                background: #ffffff12;
            }

            HorizontalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 6 * Theme.dp;
                spacing: 8 * Theme.dp;
                VerticalLayout {
                    alignment: center;
                    Glyph {
                        source: @image-url("icons/paste.svg");
                        size: 22 * Theme.dp;
                        colorize: Theme.accent;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.paste-title;
                        color: Theme.text;
                        font-size: 15 * Theme.dp;
                        font-weight: 600;
                        overflow: elide;
                    }

                    Text {
                        text: root.paste-from;
                        font-family: "DejaVu Sans";
                        color: Theme.text-dim;
                        font-size: 12.5 * Theme.dp;
                        overflow: elide;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: "Cancel";
                        flat: true;
                        clicked => {
                            root.paste-cancel();
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Pill {
                        text: root.paste-action;
                        primary: true;
                        enabled: root.view == "folder" && !root.read-only;
                        clicked => {
                            root.paste-go();
                        }
                    }
                }
            }
        }

        // F01: Browse · Recent · Types
        if root.footer: Footer {
            current: root.tab-index;
            tabs: [
                { icon: @image-url("@neoui/icons/sys/folder.svg"), label: "Browse" },
                { icon: @image-url("@neoui/icons/sys/recents.svg"), label: "Recent" },
                { icon: @image-url("@neoui/icons/sys/apps.svg"), label: "Types" },
            ];
            picked(i) => {
                root.tab(i);
            }
        }
    }

    // a name clash (files2-clash): Replace / Keep both / Skip, and whether the answer covers the rest
    if root.clash-open: Rectangle {
        background: Theme.scrim;
        TouchArea { }

        Rectangle {
            x: 16 * Theme.dp;
            width: parent.width - 32 * Theme.dp;
            height: clash-box.preferred-height;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.radius + 4 * Theme.dp;
            background: Theme.sheet;
            clash-box := VerticalLayout {
                padding: 20 * Theme.dp;
                spacing: 12 * Theme.dp;
                Text {
                    text: root.clash-title;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: 18 * Theme.dp;
                    font-weight: 600;
                    wrap: word-wrap;
                }

                Text {
                    text: root.clash-text;
                    color: Theme.text-secondary;
                    font-size: 14.5 * Theme.dp;
                    wrap: word-wrap;
                }

                if root.clash-count > 1: HorizontalLayout {
                    spacing: 12 * Theme.dp;
                    Rectangle {
                        width: 22 * Theme.dp;
                        height: self.width;
                        border-radius: 4 * Theme.dp;
                        background: root.clash-all ? Theme.accent : transparent;
                        border-width: root.clash-all ? 0 : 2 * Theme.dp;
                        border-color: Theme.text-dim;
                        if root.clash-all: Glyph {
                            source: @image-url("@neoui/icons/sys/check.svg");
                            size: 16 * Theme.dp;
                            colorize: white;
                        }
                    }

                    Text {
                        text: "Do this for all " + root.clash-count + " clashes";
                        color: Theme.text;
                        font-size: 15 * Theme.dp;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.clash-all = !root.clash-all;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    alignment: start;
                    Pill {
                        text: "Replace";
                        primary: true;
                        clicked => {
                            root.clash-answer(0);
                        }
                    }

                    Pill {
                        text: "Keep both";
                        clicked => {
                            root.clash-answer(1);
                        }
                    }

                    Pill {
                        text: "Skip";
                        clicked => {
                            root.clash-answer(2);
                        }
                    }
                }
            }
        }
    }

    // a form page over the folder: [✕ New folder ✓], [✕ New file ✓] or [✕ Rename ✓]; the keyboard comes up
    if root.form != "": Rectangle {
        background: Theme.bg;
        TouchArea { }

        VerticalLayout {
            alignment: start;
            FormHeader {
                title: root.form == "folder" ? "New folder" : root.form == "file" ? "New file" : "Rename";
                can-save: root.name-text != "";
                cancel => {
                    root.form-cancel();
                }
                save => {
                    root.form-save();
                }
            }

            // where it goes (files2-new-folder): the tile and the folder
            if root.form != "rename": HorizontalLayout {
                padding: 16 * Theme.dp;
                spacing: 14 * Theme.dp;
                VerticalLayout {
                    alignment: center;
                    if root.form == "folder": FolderTile { }
                    if root.form == "file": FTile {
                        badge: "TXT";
                        colour: #8a93a0;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.form == "folder" ? "New folder in" : "New file in";
                        color: Theme.text-dim;
                        font-size: Theme.font-label;
                    }

                    Text {
                        text: root.form-dir;
                        font-family: "DejaVu Sans Mono";
                        color: Theme.text;
                        font-size: 15 * Theme.dp;
                        overflow: elide;
                    }
                }
            }
            VerticalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 16 * Theme.dp;
                padding-top: root.form == "rename" ? 16 * Theme.dp : 0;
                spacing: 8 * Theme.dp;
                SectionLabel {
                    text: "NAME";
                }

                HorizontalLayout {
                    spacing: 8 * Theme.dp;
                    TextField {
                        horizontal-stretch: 1;
                        text <=> root.name-text;
                        placeholder: "Name";
                        autofocus: true;
                        accepted(t) => {
                            root.form-save();
                        }
                    }

                    if root.name-suffix != "": Text {
                        text: root.name-suffix;
                        font-family: "DejaVu Sans";
                        color: Theme.text-secondary;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.form == "rename" && root.name-suffix != "" ? "The extension stays " + root.name-suffix : "Up to 256 characters. Not allowed: \\ / : * ? \" < > |";
                    color: Theme.text-dim;
                    font-size: 12.5 * Theme.dp;
                    wrap: word-wrap;
                }
            }

            // what is renamed and where (files2-rename)
            if root.form == "rename": VerticalLayout {
                padding: 16 * Theme.dp;
                spacing: 8 * Theme.dp;
                SectionLabel {
                    text: "IN";
                }

                HorizontalLayout {
                    spacing: 14 * Theme.dp;
                    VerticalLayout {
                        alignment: center;
                        if root.form-badge == "": FolderTile { }
                        if root.form-badge != "": FTile {
                            badge: root.form-badge;
                            colour: root.form-colour;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 3 * Theme.dp;
                        Text {
                            text: root.form-dir;
                            font-family: "DejaVu Sans";
                            color: Theme.text;
                            font-size: Theme.font-body;
                            overflow: elide;
                        }

                        Text {
                            text: root.form-detail;
                            color: Theme.text-dim;
                            font-size: Theme.font-label;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // the Sort sheet (files2-sort): last in the window, full size
    Sheet {
        title: "Sort by";
        open <=> root.sort-open;
        for k[i] in ["Name", "Date modified", "Size", "Type"]: RadioRow {
            label: k;
            on: i == root.sort-key;
            picked => {
                root.sort-chosen(i);
            }
        }
        Rectangle {
            height: max(1px, Theme.dp / 2);
            background: #ffffff12;
        }

        SwitchRow {
            label: "Ascending";
            hint: "A → Z · oldest first · smallest first";
            on: root.ascending;
            toggled(v) => {
                root.ascending-changed(v);
            }
        }

        SwitchRow {
            label: "Folders first";
            hint: "Then files, in the same order";
            on: root.folders-first;
            toggled(v) => {
                root.folders-first-changed(v);
            }
        }
    }

    // files2-search-filters: Type, Size, Modified; Reset and Show N results
    Sheet {
        title: "Filters";
        open <=> root.filters-open;
        VerticalLayout {
            padding-left: 16 * Theme.dp;
            padding-right: 16 * Theme.dp;
            spacing: 8 * Theme.dp;
            SectionLabel {
                text: "TYPE";
            }

            for r in [[0, 1, 2, 3], [4, 5, 6], [7]]: HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                for i in r: Pick {
                    text: ["Any", "Images", "Audio", "Video", "Documents", "Archives", "Apps", "Code & text"][i];
                    on: i == root.f-type;
                    clicked => {
                        root.filter-type(i);
                    }
                }
            }
            SectionLabel {
                text: "SIZE";
            }

            for r in [[0, 1, 2], [3]]: HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                for i in r: Pick {
                    text: ["Any", "Under 1 MB", "1–100 MB", "Over 100 MB"][i];
                    on: i == root.f-size;
                    clicked => {
                        root.filter-size(i);
                    }
                }
            }
            SectionLabel {
                text: "MODIFIED";
            }

            for r in [[0, 1, 2], [3, 4]]: HorizontalLayout {
                spacing: 8 * Theme.dp;
                alignment: start;
                for i in r: Pick {
                    text: ["Any time", "Today", "This week", "This month", "This year"][i];
                    on: i == root.f-modified;
                    clicked => {
                        root.filter-modified(i);
                    }
                }
            }
            HorizontalLayout {
                padding-top: 10 * Theme.dp;
                padding-bottom: 12 * Theme.dp;
                spacing: 10 * Theme.dp;
                Button {
                    horizontal-stretch: 1;
                    text: "Reset";
                    primary: false;
                    clicked => {
                        root.filters-reset();
                    }
                }

                Button {
                    horizontal-stretch: 1;
                    text: root.filter-results == 1 ? "Show 1 result" : "Show " + root.filter-results + " results";
                    clicked => {
                        root.filters-open = false;
                    }
                }
            }
        }
    }

    // files2-details: what it is, where, when; Read-only and Hidden can change, System can't
    Sheet {
        title: "Details";
        open <=> root.details-open;
        HorizontalLayout {
            padding-left: 20 * Theme.dp;
            padding-right: 20 * Theme.dp;
            padding-bottom: 12 * Theme.dp;
            spacing: 14 * Theme.dp;
            VerticalLayout {
                alignment: center;
                if root.details-item.folder: FolderTile {
                    size: 48 * Theme.dp;
                }
                if !root.details-item.folder: FTile {
                    size: 48 * Theme.dp;
                    badge: root.details-item.badge;
                    colour: root.details-item.colour;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 2 * Theme.dp;
                horizontal-stretch: 1;
                Text {
                    text: root.details-item.name;
                    font-family: "DejaVu Sans";
                    color: Theme.text;
                    font-size: 17 * Theme.dp;
                    font-weight: 600;
                    overflow: elide;
                }

                Text {
                    text: root.details-kind;
                    color: Theme.text-dim;
                    font-size: 13.5 * Theme.dp;
                }
            }
        }

        for d in root.details: DetailRow {
            d: d;
        }
        if root.details-attributes: VerticalLayout {
            padding-top: 10 * Theme.dp;
            SectionLabel {
                x: 20 * Theme.dp;
                text: "ATTRIBUTES";
            }

            SwitchRow {
                label: "Read-only";
                on: root.d-read-only;
                toggled(v) => {
                    root.details-read-only(v);
                }
            }

            SwitchRow {
                label: "Hidden";
                on: root.d-hidden;
                toggled(v) => {
                    root.details-hidden(v);
                }
            }

            SwitchRow {
                label: "System";
                hint: "Set by Symbian, not changeable";
                on: root.d-system;
                enabled: false;
            }
        }
    }
}
