// SPDX-License-Identifier: GPL-3.0-only
// FA5: the image viewer (files2-view-image) and the image editor (files2-edit-image). Rust decodes, keeps zoom and pan,
// and reads the pinch from raw touches; here one finger reports taps and drags, and the chrome is drawn.
import { Theme, Glyph, SubHeader, Button, Chip, ChoiceSheet } from "@neoui/kit.slint";

// "4032 × 3024" comes from Rust: Slint bakes only the glyphs its literals use, so the × is named here
component Glyphs inherits Text {
    visible: false;
    text: "×";
    font-family: "DejaVu Sans";
}

// one thumbnail of the viewer's strip
export struct StripItem { img: image, has: bool }

// the picture fitted to its box, then zoomed (1 = fit) and panned around the box's centre
component Picture inherits Rectangle {
    in property <image> source;
    in property <float> zoom: 1;
    in property <length> pan-x;
    in property <length> pan-y;
    property <length> iw: max(1, root.source.width) * 1px;
    property <length> ih: max(1, root.source.height) * 1px;
    out property <float> fit: min(root.width / root.iw, root.height / root.ih);
    clip: true;
    Image {
        source: root.source;
        width: root.iw * root.fit * root.zoom;
        height: root.ih * root.fit * root.zoom;
        x: (root.width - self.width) / 2 + root.pan-x;
        y: (root.height - self.height) / 2 + root.pan-y;
    }
}

// a pill over the photo (the counter, the zoom hint)
component Chip2 inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon;
    in property <color> ground: #000000a0;
    height: 28 * Theme.dp;
    width: row.preferred-width + 24 * Theme.dp;
    border-radius: self.height / 2;
    background: root.ground;
    row := HorizontalLayout {
        alignment: center;
        spacing: 8 * Theme.dp;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Glyph {
                source: root.icon;
                size: 16 * Theme.dp;
                colorize: Theme.text-secondary;
            }
        }
        Text {
            text: root.text;
            color: root.has-icon ? Theme.text-secondary : Theme.text;
            font-size: 13 * Theme.dp;
            font-weight: root.has-icon ? 400 : 600;
            vertical-alignment: center;
        }
    }
}

export component ImageView inherits Rectangle {
    in property <string> name;
    // "3 / 1,038"; "29 Oct 2026 · 4032 × 3024 · 3.1 MB"; "Shown at preview size" (an EXIF preview)
    in property <string> counter;
    in property <string> info;
    in property <string> note;
    in property <image> source;
    in property <float> zoom: 1;
    in property <length> pan-x;
    in property <length> pan-y;
    in property <bool> chrome: true;
    in property <bool> hint;
    in property <bool> editable;
    in property <[StripItem]> strip;
    in property <int> current;
    in property <[string]> menu;
    // the picture's box and its fit scale, for Rust's pan limits
    out property <float> fit: pic.fit;
    callback back();
    callback edit();
    callback menu-picked(int);
    callback strip-picked(int);
    // one finger: a tap (toggles the chrome), a double tap, a drag since the press, and its release
    callback tapped();
    callback double-tapped(length, length);
    callback dragged(length, length);
    callback released(length, length);
    background: black;
    Glyphs { }

    pic := Picture {
        source: root.source;
        zoom: root.zoom;
        pan-x: root.pan-x;
        pan-y: root.pan-y;
    }

    touch := TouchArea {
        property <bool> far;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.far = false;
            } else if e.kind == PointerEventKind.up && self.far {
                root.released(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        moved => {
            if self.pressed {
                if abs(self.mouse-x - self.pressed-x) > 8 * Theme.dp || abs(self.mouse-y - self.pressed-y) > 8 * Theme.dp {
                    self.far = true;
                }
                if self.far {
                    root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }
        }
        clicked => {
            if !self.far {
                root.tapped();
            }
        }
        double-clicked => {
            root.double-tapped(self.mouse-x, self.mouse-y);
        }
    }

    if root.chrome: Rectangle {
        y: 0;
        height: Theme.header-h + 28 * Theme.dp;
        background: @linear-gradient(180deg, #000000c0 0%, #00000000 100%);
        SubHeader {
            y: 0;
            height: Theme.header-h;
            background: transparent;
            title: root.name;
            title-font: "DejaVu Sans";
            search: false;
            actions: root.editable ? [{ icon: @image-url("@neoui/icons/sys/edit.svg"), label: "Edit" }] : [];
            menu: root.menu;
            back => {
                root.back();
            }
            action(i) => {
                root.edit();
            }
            menu-picked(i) => {
                root.menu-picked(i);
            }
        }
    }
    if root.chrome && root.counter != "": Chip2 {
        x: (parent.width - self.width) / 2;
        y: Theme.header-h + 8 * Theme.dp;
        text: root.counter;
    }
    if root.chrome && root.hint: Chip2 {
        x: (parent.width - self.width) / 2;
        y: parent.height - 136 * Theme.dp - self.height;
        ground: #1d2025;
        has-icon: true;
        icon: @image-url("icons/zoom_in.svg");
        text: "Double-tap or pinch to zoom";
    }
    if root.chrome: Rectangle {
        y: parent.height - self.height;
        height: 112 * Theme.dp;
        background: @linear-gradient(180deg, #00000000 0%, #000000d0 40%);
        VerticalLayout {
            padding-top: 26 * Theme.dp;
            spacing: 4 * Theme.dp;
            Text {
                x: 16 * Theme.dp;
                text: root.note != "" ? root.info + " · " + root.note : root.info;
                font-family: "DejaVu Sans";
                color: Theme.text-secondary;
                font-size: 13 * Theme.dp;
                horizontal-alignment: left;
                overflow: elide;
            }
            HorizontalLayout {
                height: 64 * Theme.dp;
                alignment: center;
                spacing: 6 * Theme.dp;
                for s[i] in root.strip: VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: (i == root.current ? 52 : 44) * Theme.dp;
                        height: self.width;
                        border-radius: (i == root.current ? 8 : 6) * Theme.dp;
                        border-width: i == root.current ? 2 * Theme.dp : 0;
                        border-color: white;
                        background: #2a2e35;
                        clip: true;
                        opacity: i == root.current ? 1 : 0.7;
                        if s.has: Image {
                            width: 100%;
                            height: 100%;
                            source: s.img;
                            image-fit: cover;
                        }
                        TouchArea {
                            clicked => {
                                root.strip-picked(i);
                            }
                        }
                    }
                }
            }
        }
    }
}

// one of the editor's four tools
component Tool inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 64 * Theme.dp;
    border-radius: 14 * Theme.dp;
    background: root.on ? #3d8bfd29 : t.pressed ? Theme.pressed : transparent;
    accessible-role: button;
    accessible-label: root.text;
    VerticalLayout {
        alignment: center;
        spacing: 5 * Theme.dp;
        HorizontalLayout {
            alignment: center;
            Glyph {
                source: root.icon;
                size: 24 * Theme.dp;
                colorize: root.on ? Theme.accent : Theme.text-secondary;
            }
        }
        Text {
            text: root.text;
            color: root.on ? Theme.accent : Theme.text-secondary;
            font-size: 12.5 * Theme.dp;
            font-weight: 600;
            horizontal-alignment: center;
        }
    }
    t := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// a crop handle's touch area (44 dp): reports its drag since the press
component Grip inherits TouchArea {
    in property <int> handle;
    callback start(int);
    callback drag(int, length, length);
    callback done();
    pointer-event(e) => {
        if e.kind == PointerEventKind.down {
            root.start(root.handle);
        } else if e.kind == PointerEventKind.up {
            root.done();
        }
    }
    moved => {
        if self.pressed {
            root.drag(root.handle, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
        }
    }
}

export component ImageEdit inherits Rectangle {
    in property <string> name;
    in property <image> source;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> cropping;
    // the crop box over the shown picture, in its pixels
    in property <length> crop-x;
    in property <length> crop-y;
    in property <length> crop-w;
    in property <length> crop-h;
    in property <string> size-label;
    // 0 Free, 1 Original, 2 1:1, 3 4:3, 4 16:9
    in property <int> ratio;
    // "Saves sunset-edit.jpg;\nthe original stays."
    in property <string> note;
    in property <bool> saving;
    in-out property <bool> resize-open;
    in property <[string]> resize-choices;
    in property <int> resize-current;
    // the shown picture's size (Rust maps crop drags to the image with it)
    out property <length> box-w: max(1, root.source.width) * 1px * pic.fit;
    out property <length> box-h: max(1, root.source.height) * 1px * pic.fit;
    callback back();
    callback undo();
    callback redo();
    callback menu-picked(int);
    callback rotate();
    callback crop-mode();
    callback resize();
    callback flip();
    callback save();
    callback ratio-picked(int);
    callback crop-start(int);
    callback crop-drag(int, length, length);
    callback crop-done();
    callback resize-chosen(int);
    background: black;

    VerticalLayout {
        SubHeader {
            alt: true;
            title: root.name;
            title-font: "DejaVu Sans";
            search: false;
            actions: [
                { icon: @image-url("icons/undo.svg"), label: "Undo", disabled: !root.can-undo },
                { icon: @image-url("icons/redo.svg"), label: "Redo", disabled: !root.can-redo },
            ];
            menu: ["Reset", "Details"];
            back => {
                root.back();
            }
            action(i) => {
                if i == 0 {
                    root.undo();
                } else {
                    root.redo();
                }
            }
            menu-picked(i) => {
                root.menu-picked(i);
            }
        }

        area := Rectangle {
            vertical-stretch: 1;
            pic := Picture {
                x: 8 * Theme.dp;
                width: parent.width - 16 * Theme.dp;
                source: root.source;
            }
            // the box's corner in the area
            property <length> bx: pic.x + (pic.width - root.box-w) / 2;
            property <length> by: (pic.height - root.box-h) / 2;
            if root.cropping: Rectangle {
                x: parent.bx;
                y: parent.by;
                width: root.box-w;
                height: root.box-h;
                // the dimmed outside (x and y given: Slint centres a smaller child)
                Rectangle {
                    x: 0;
                    y: 0;
                    height: root.crop-y;
                    background: #000000a6;
                }
                Rectangle {
                    x: 0;
                    y: root.crop-y + root.crop-h;
                    height: parent.height - self.y;
                    background: #000000a6;
                }
                Rectangle {
                    x: 0;
                    y: root.crop-y;
                    width: root.crop-x;
                    height: root.crop-h;
                    background: #000000a6;
                }
                Rectangle {
                    x: root.crop-x + root.crop-w;
                    y: root.crop-y;
                    width: parent.width - self.x;
                    height: root.crop-h;
                    background: #000000a6;
                }
                // the box, its thirds, its handles
                Rectangle {
                    x: root.crop-x;
                    y: root.crop-y;
                    width: root.crop-w;
                    height: root.crop-h;
                    border-width: 1.5 * Theme.dp;
                    border-color: white;
                    for k in 2: Rectangle {
                        x: parent.width * (k + 1) / 3;
                        width: 1px;
                        background: #ffffff66;
                    }
                    for k in 2: Rectangle {
                        y: parent.height * (k + 1) / 3;
                        height: 1px;
                        background: #ffffff66;
                    }
                    for c[i] in [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 0, y: 1 }, { x: 1, y: 1 }]: Rectangle {
                        x: c.x * (parent.width - self.width) + (c.x * 2 - 1) * 3px;
                        y: c.y * (parent.height - self.height) + (c.y * 2 - 1) * 3px;
                        width: 18 * Theme.dp;
                        height: 18 * Theme.dp;
                        Rectangle {
                            x: c.x * (parent.width - self.width);
                            width: 4 * Theme.dp;
                            background: white;
                        }
                        Rectangle {
                            y: c.y * (parent.height - self.height);
                            height: 4 * Theme.dp;
                            background: white;
                        }
                    }
                    Rectangle {
                        y: 4px;
                        x: 4 * Theme.dp;
                        width: label.preferred-width + 14 * Theme.dp;
                        height: 20 * Theme.dp;
                        border-radius: 5 * Theme.dp;
                        background: #000000b3;
                        label := Text {
                            text: root.size-label;
                            font-family: "DejaVu Sans";
                            color: white;
                            font-size: 11.5 * Theme.dp;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    // 0 inside (move), 1–4 corners, 5 top, 6 bottom, 7 left, 8 right
                    Grip {
                        handle: 0;
                        x: 22 * Theme.dp;
                        y: 22 * Theme.dp;
                        width: max(0px, parent.width - 44 * Theme.dp);
                        height: max(0px, parent.height - 44 * Theme.dp);
                        start(h) => { root.crop-start(h); }
                        drag(h, dx, dy) => { root.crop-drag(h, dx, dy); }
                        done => { root.crop-done(); }
                    }
                    for g in [
                        { h: 5, x: 0.5, y: 0 }, { h: 6, x: 0.5, y: 1 }, { h: 7, x: 0, y: 0.5 }, { h: 8, x: 1, y: 0.5 },
                        { h: 1, x: 0, y: 0 }, { h: 2, x: 1, y: 0 }, { h: 3, x: 0, y: 1 }, { h: 4, x: 1, y: 1 },
                    ]: Grip {
                        handle: g.h;
                        width: 44 * Theme.dp;
                        height: 44 * Theme.dp;
                        x: parent.width * g.x - self.width / 2;
                        y: parent.height * g.y - self.height / 2;
                        start(h) => { root.crop-start(h); }
                        drag(h, dx, dy) => { root.crop-drag(h, dx, dy); }
                        done => { root.crop-done(); }
                    }
                }
            }
        }

        if root.cropping: HorizontalLayout {
            height: 48 * Theme.dp;
            alignment: center;
            spacing: 8 * Theme.dp;
            for r[i] in ["Free", "Original", "1:1", "4:3", "16:9"]: VerticalLayout {
                alignment: center;
                Chip {
                    text: r;
                    on: i == root.ratio;
                    toggled => {
                        root.ratio-picked(i);
                    }
                }
            }
        }

        Rectangle {
            height: 80 * Theme.dp;
            Rectangle {
                y: 0;
                height: 1px;
                background: #ffffff12;
            }
            HorizontalLayout {
                padding: 8 * Theme.dp;
                padding-left: 12 * Theme.dp;
                padding-right: 12 * Theme.dp;
                spacing: 6 * Theme.dp;
                Tool {
                    icon: @image-url("icons/rotate.svg");
                    text: "Rotate";
                    clicked => {
                        root.rotate();
                    }
                }
                Tool {
                    icon: @image-url("icons/crop.svg");
                    text: "Crop";
                    on: root.cropping;
                    clicked => {
                        root.crop-mode();
                    }
                }
                Tool {
                    icon: @image-url("icons/resize.svg");
                    text: "Resize";
                    clicked => {
                        root.resize();
                    }
                }
                Tool {
                    icon: @image-url("icons/flip.svg");
                    text: "Flip";
                    clicked => {
                        root.flip();
                    }
                }
            }
        }

        Rectangle {
            height: 68 * Theme.dp;
            background: Theme.header-alt;
            Rectangle {
                y: 0;
                height: 1px;
                background: #ffffff12;
            }
            HorizontalLayout {
                padding-left: 16 * Theme.dp;
                padding-right: 16 * Theme.dp;
                spacing: 12 * Theme.dp;
                Text {
                    text: root.note;
                    color: Theme.text-dim;
                    font-size: 12.5 * Theme.dp;
                    font-family: "DejaVu Sans";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                    overflow: elide;
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        text: root.saving ? "Saving…" : "Save as copy";
                        enabled: !root.saving;
                        clicked => {
                            root.save();
                        }
                    }
                }
            }
        }
    }

    ChoiceSheet {
        title: "Resize";
        open <=> root.resize-open;
        choices: root.resize-choices;
        current: root.resize-current;
        chosen(i) => {
            root.resize-chosen(i);
        }
    }
}
